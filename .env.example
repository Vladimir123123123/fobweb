# Сайт, который видит браузер. Node снаружи только через PHP-прокси.
SITE_ORIGIN=http://localhost:4321
# Случайная длинная строка. Ею подписывается вход.
SESSION_SECRET=change-me-to-a-long-random-string
# Секретный кусок адреса админки. Его нет в меню. Совпадает у сайта и API.
ADMIN_PATH=local-staff-gate
# Ваш SteamID64. Первый админ, до любых приглашений.
OWNER_STEAM_ID=
# Ключ Steam Web API: ник, аватар и страна профиля. Без него вход всё равно создаёт SteamID.
STEAM_WEB_API_KEY=
# Сезон в снимках прогресса.
GAME_SEASON=02
# Ключ, которым программа синка сдаёт снимок на Node. В браузер не попадает.
SYNC_INGEST_KEY=
# Необязательная привязка Discord. Вход на сайт через Discord не включается.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Куда ведёт кнопка «В Discord». Это сервер FOB.
PUBLIC_DISCORD_INVITE=https://discord.gg/fob
# Номер счётчика. Пусто — счётчик не вставляется.
PUBLIC_METRIKA_ID=
DATABASE_URL=postgres://wardogs:wardogs@localhost:5432/wardogs
API_PORT=3000
