---
import Base from "../../layouts/Base.astro";

export function getStaticPaths() {
  const code = process.env.ADMIN_PATH || "local-staff-gate";
  return [{ params: { code } }];
}
---
<Base title="Страница" robots="noindex">
  <div id="gate">
    <h1>Такой страницы нет</h1>
    <p>Проверьте адрес.</p>
  </div>
</Base>
<script>
  const gate = document.querySelector("#gate")!;
  const invite = new URLSearchParams(location.search).get("invite");
  let session: Response;
  try {
    session = await fetch("/api/admin/session");
  } catch {
    session = new Response(null, { status: 404 });
  }
  if (session.status === 404 && invite) {
    gate.innerHTML = `<h1>Подтверждение Steam</h1><p>Ссылка одноразовая. После входа через Steam она погаснет, а доступ останется на вашем SteamID.</p><a class="btn" href="/auth/steam?next=${encodeURIComponent(location.pathname + location.search)}">Подтвердить Steam</a>`;
    const me = await fetch("/api/me").then((response) => response.json()).catch(() => null);
    if (me?.user) {
      const redeemed = await fetch("/api/admin/invites/redeem", {
        method: "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify({ token: invite }),
      });
    if (redeemed.ok) location.href = location.pathname;
      else gate.innerHTML = "<h1>Такой страницы нет</h1><p>Проверьте адрес.</p>";
    }
  }
  if (session.ok) {
    const data = await fetch("/api/admin/overview").then((response) => response.json());
    const count = (name: string) => data.sync.find((row: { status: string; count: number }) => row.status === name)?.count ?? 0;
    const esc = (value: string) => value.replace(/[&<>"']/g, (ch) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[ch] ?? ch);
    gate.innerHTML = `
      <h1>Сводка</h1>
      <div class="stats">
        <div class="stat"><b>${data.liveCis}</b><span>Живые профили СНГ, 7 дней</span></div>
        <div class="stat"><b>${data.views7d}</b><span>Просмотры, 7 дней</span></div>
        <div class="stat"><b>${data.discordClicks7d}</b><span>Клики в Discord, 7 дней</span></div>
        <div class="stat"><b>${data.shares7d}</b><span>Ссылки сборок, 7 дней</span></div>
      </div>
      <p class="note">Входы за 7 дней: ${data.logins7d}. Клики по баннерам сквадов: ${data.squadBannerClicks7d ?? 0}. Сессии синка: живые ${count("active")}, погасшие ${count("expired")}.</p>
      <h2>Гайды</h2>
      <p class="note">Пустая строка начинает абзац. Строка с «- » — пункт списка. **так** выделяет слово. Ссылка необязательна: страница сайта вроде /ratings или адрес https://…</p>
      <form id="guide-form" class="guide-form">
        <label>Рубрика<input id="guide-rubric" maxlength="40" placeholder="Steam"></label>
        <label>Заголовок<input id="guide-title" maxlength="120" required></label>
        <label>Текст<textarea id="guide-body" maxlength="8000" required></textarea></label>
        <label>Ссылка<input id="guide-href" maxlength="200" placeholder="/ratings"></label>
        <label>Порядок<input id="guide-sort" type="number" min="0" max="9999" value="0"></label>
        <label class="check"><input id="guide-hidden" type="checkbox"> Скрыть с сайта</label>
        <div class="row">
          <button class="btn" id="guide-save" type="submit">Добавить</button>
          <button class="btn ghost" id="guide-cancel" type="button" hidden>Отмена</button>
        </div>
        <p id="guide-note" class="note"></p>
      </form>
      <div id="guide-list"></div>
      <h2>Топ сезона ${esc(String(data.season ?? ""))}</h2>
      <p class="note">В этом сезоне снимков: ${data.seasonPlayers ?? 0}. Кнопка стирает только текущий сезон. Сезон 2 остаётся.</p>
      <button class="btn" id="reset-season" type="button">Обнулить топ сезона</button>
      <p id="reset-note" class="note"></p>
      <h2>Запросы в поиске</h2>
      <p class="note">Страницы подписаны под эти формулировки. Таблица ниже — слова, которые поисковик передал вместе с переходом. Google часто их не отдаёт.</p>
      <p class="tags">${(data.searchTags ?? []).map((tag: string) => `<span>${esc(tag)}</span>`).join("")}</p>
      <div class="scroll"><table><tbody>
        ${(data.searchHits ?? []).map((row: { engine: string; query: string; count: number }) => `<tr><td>${esc(row.engine || "")}</td><td>${esc(row.query || "")}</td><td>${row.count}</td></tr>`).join("") || "<tr><td>Пока нет перехода, где поисковик передал текст запроса.</td></tr>"}
      </tbody></table></div>
      <h2>Откуда пришли</h2>
      <div class="scroll"><table><tbody>
        ${data.sources.map((row: { source: string; count: number }) => `<tr><td>${row.source}</td><td>${row.count}</td></tr>`).join("")}
      </tbody></table></div>
      <h2>По дням</h2>
      <div class="scroll"><table><tbody>
        ${data.days.map((row: { day: string; count: number }) => `<tr><td>${row.day}</td><td>${row.count}</td></tr>`).join("")}
      </tbody></table></div>
      <h2>Игроки в топе</h2>
      <p class="note">По умолчанию все в рейтинге. Здесь можно скрыть или вернуть вручную.</p>
      <div class="scroll"><table><tbody id="players">
        ${data.players.map((player: { steam_id: string; persona: string | null; hide_leaderboard: boolean; cis_opt_in?: boolean }) => {
          const hidden = Boolean(player.hide_leaderboard) || player.cis_opt_in === false;
          return `<tr><td><a href="/p?id=${player.steam_id}">${player.persona ?? player.steam_id}</a></td><td>${hidden ? "скрыт" : "в топе"}</td><td><button class="btn ghost small" data-hide="${player.steam_id}" data-on="${hidden ? "1" : "0"}" type="button">${hidden ? "Показать в топе" : "Скрыть из топа"}</button></td></tr>`;
        }).join("")}
      </tbody></table></div>
      <h2>Картинки сквадов</h2>
      <div id="assets">${(data.assets ?? []).map((asset: { id: number; kind: string; path: string; discord_url: string; tag: string; name: string }) => `<article class="panel"><img class="${asset.kind === "logo" ? "asset-preview logo" : "asset-preview"}" src="/api/media/${esc(asset.path)}" alt="" /><p>[${esc(asset.tag)}] ${esc(asset.name)} · ${asset.kind === "logo" ? "логотип" : "баннер"}</p>${asset.discord_url ? `<p>${esc(asset.discord_url)}</p>` : ""}<button class="btn small" data-asset="${asset.id}" data-accept="1" type="button">Одобрить</button> <button class="btn ghost small" data-asset="${asset.id}" data-accept="0" type="button">Отклонить</button></article>`).join("") || "<p>Новых картинок нет.</p>"}</div>
      <h2>Жалобы на участников</h2>
      <div id="reports">${(data.reports ?? []).map((report: { id: number; tag: string; name: string; target_name: string | null; target_steam_id: string; reporter_name: string | null; note: string }) => `<p>[${esc(report.tag)}] ${esc(report.name)} · на <a href="/p?id=${report.target_steam_id}">${esc(report.target_name ?? report.target_steam_id)}</a> · от ${esc(report.reporter_name ?? "игрока")}<br>${esc(report.note)} <button class="btn ghost small" data-report="${report.id}" type="button">Закрыть</button></p>`).join("") || "<p>Открытых жалоб нет.</p>"}</div>
      <h2>Сквады</h2>
      <div id="squads">${data.squads.map((squad: { id: number; tag: string; name: string; closed: boolean; status: string; has_banner: boolean; has_logo: boolean; persona: string | null }) => `<p>[${esc(squad.tag)}] ${esc(squad.name)} · ${esc(squad.persona ?? "")} · ${squad.status === "approved" ? "в списке" : squad.status === "rejected" ? "отклонён" : "ждёт проверки"} ${squad.status === "approved" ? `<button class="btn ghost small" data-review="${squad.id}" data-accept="0" type="button">Убрать из списка</button>` : `<button class="btn small" data-review="${squad.id}" data-accept="1" type="button">Одобрить сквад</button>`} ${squad.closed ? "набор закрыт" : `<button class="btn ghost small" data-close="${squad.id}" type="button">Закрыть набор</button>`} ${squad.has_banner ? `<button class="btn ghost small" data-clear="${squad.id}" data-kind="banner" type="button">Снять баннер</button>` : ""} ${squad.has_logo ? `<button class="btn ghost small" data-clear="${squad.id}" data-kind="logo" type="button">Скрыть логотип</button>` : ""}</p>`).join("")}</div>
      <h2>Сборки</h2>
      <div id="builds">${(data.builds ?? []).map((build: { id: number; title: string; season: string; hidden: boolean; persona: string | null }) => `<p><a href="/b?id=${build.id}">${esc(build.title)}</a> · сезон ${esc(String(build.season))} · ${esc(build.persona ?? "")} ${build.hidden ? `<button class="btn ghost small" data-build="${build.id}" data-on="1" type="button">Вернуть</button>` : `<button class="btn ghost small" data-build="${build.id}" data-on="0" type="button">Скрыть</button>`}</p>`).join("")}</div>
      <h2>Ссылка доступа</h2>
      <button class="btn" id="invite" type="button">Выдать ссылку на 48 часов</button>
      <p id="invite-url"></p>
    `;
    type GuideRow = { id: number; rubric: string; title: string; body: string; href: string; sort_order: number; hidden: boolean };
    const guideRows: GuideRow[] = data.guides ?? [];
    const guideForm = gate.querySelector<HTMLFormElement>("#guide-form");
    const guideList = gate.querySelector("#guide-list");
    const guideNote = gate.querySelector("#guide-note");
    const guideCancel = gate.querySelector<HTMLButtonElement>("#guide-cancel");
    const guideSave = gate.querySelector("#guide-save");
    let editing = 0;
    const field = (id: string) => gate.querySelector<HTMLInputElement | HTMLTextAreaElement>(id);
    const paintGuides = () => {
      if (!guideList) return;
      guideList.innerHTML = guideRows.map((guide) => `<p><b>${esc(guide.title)}</b> · ${esc(guide.rubric || "без рубрики")} · ${guide.hidden ? "скрыт" : "на сайте"} <button class="btn ghost small" data-guide-edit="${guide.id}" type="button">Править</button> <button class="btn ghost small" data-guide-hide="${guide.id}" type="button">${guide.hidden ? "Показать" : "Скрыть"}</button> <button class="btn ghost small" data-guide-delete="${guide.id}" type="button">Удалить</button></p>`).join("") || "<p>Пока пусто.</p>";
    };
    const clearGuide = () => {
      editing = 0;
      guideForm?.reset();
      if (guideSave) guideSave.textContent = "Добавить";
      guideCancel?.setAttribute("hidden", "");
    };
    paintGuides();
    guideForm?.addEventListener("submit", async (event) => {
      event.preventDefault();
      const payload = {
        rubric: field("#guide-rubric")?.value ?? "",
        title: field("#guide-title")?.value ?? "",
        body: field("#guide-body")?.value ?? "",
        href: field("#guide-href")?.value ?? "",
        sort: Number(field("#guide-sort")?.value || 0),
        hidden: gate.querySelector<HTMLInputElement>("#guide-hidden")?.checked === true,
      };
      const response = await fetch(editing ? `/api/admin/guides/${editing}` : "/api/admin/guides", {
        method: editing ? "PATCH" : "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify(payload),
      });
      if (!response.ok) {
        if (guideNote) guideNote.textContent = "Не сохранилось. Нужны заголовок и текст.";
        return;
      }
      location.reload();
    });
    guideCancel?.addEventListener("click", clearGuide);
    guideList?.addEventListener("click", async (event) => {
      const button = (event.target as Element).closest<HTMLButtonElement>("button");
      if (!button) return;
      const id = Number(button.dataset.guideEdit || button.dataset.guideHide || button.dataset.guideDelete);
      const guide = guideRows.find((item) => item.id === id);
      if (!guide) return;
      if (button.dataset.guideEdit) {
        editing = guide.id;
        const rubric = field("#guide-rubric");
        const title = field("#guide-title");
        const body = field("#guide-body");
        const href = field("#guide-href");
        const sort = field("#guide-sort");
        const hidden = gate.querySelector<HTMLInputElement>("#guide-hidden");
        if (rubric) rubric.value = guide.rubric || "";
        if (title) title.value = guide.title;
        if (body) body.value = guide.body;
        if (href) href.value = guide.href || "";
        if (sort) sort.value = String(guide.sort_order || 0);
        if (hidden) hidden.checked = Boolean(guide.hidden);
        if (guideSave) guideSave.textContent = "Сохранить";
        guideCancel?.removeAttribute("hidden");
        guideForm?.scrollIntoView({ block: "center" });
        return;
      }
      if (button.dataset.guideHide) {
        await fetch(`/api/admin/guides/${guide.id}`, {
          method: "PATCH",
          headers: { "content-type": "application/json" },
          body: JSON.stringify({ ...guide, sort: guide.sort_order, hidden: !guide.hidden }),
        });
        location.reload();
        return;
      }
      if (button.dataset.guideDelete && confirm(`Удалить «${guide.title}»?`)) {
        await fetch(`/api/admin/guides/${guide.id}`, { method: "DELETE" });
        location.reload();
      }
    });
    gate.querySelector("#reset-season")?.addEventListener("click", async () => {
      if (!confirm(`Обнулить топ сезона ${data.season}? Снимки сезона 2 не удаляются.`)) return;
      const typed = prompt("Для подтверждения напишите ОБНУЛИТЬ");
      if (typed !== "ОБНУЛИТЬ") return;
      const response = await fetch("/api/admin/season/reset", {
        method: "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify({ confirm: "ОБНУЛИТЬ" }),
      });
      const payload = await response.json().catch(() => ({}));
      const note = gate.querySelector("#reset-note");
      if (!response.ok) {
        if (note) note.textContent = payload.error === "season_locked"
          ? "Сезон 2 не обнуляется. На сервере API в GAME_SEASON должен быть 03, затем перезапуск Node."
          : "Не вышло.";
        return;
      }
      if (note) note.textContent = `Снято снимков: ${payload.removed}. Сезон ${payload.season}.`;
      location.reload();
    });
    gate.querySelector("#invite")?.addEventListener("click", async () => {
      const response = await fetch("/api/admin/invites", { method: "POST" });
      const payload = await response.json();
      const node = gate.querySelector("#invite-url");
      if (node) node.textContent = payload.url ?? "";
    });
    gate.querySelectorAll<HTMLButtonElement>("[data-hide]").forEach((button) => {
      button.addEventListener("click", async () => {
        await fetch(`/api/admin/players/${button.dataset.hide}/hide`, {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: JSON.stringify({ hide: button.dataset.on !== "1" }),
        });
        location.reload();
      });
    });
    gate.querySelectorAll<HTMLButtonElement>("[data-close]").forEach((button) => {
      button.addEventListener("click", async () => {
        await fetch(`/api/admin/squads/${button.dataset.close}/close`, { method: "POST" });
        location.reload();
      });
    });
    gate.querySelectorAll<HTMLButtonElement>("[data-review]").forEach((button) => {
      button.addEventListener("click", async () => {
        await fetch(`/api/admin/squads/${button.dataset.review}/review`, {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: JSON.stringify({ accept: button.dataset.accept === "1" }),
        });
        location.reload();
      });
    });
    gate.querySelectorAll<HTMLButtonElement>("[data-clear]").forEach((button) => {
      button.addEventListener("click", async () => {
        await fetch(`/api/admin/squads/${button.dataset.clear}/clear`, {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: JSON.stringify({ kind: button.dataset.kind }),
        });
        location.reload();
      });
    });
    gate.querySelectorAll<HTMLButtonElement>("[data-asset]").forEach((button) => {
      button.addEventListener("click", async () => {
        await fetch(`/api/admin/assets/${button.dataset.asset}/review`, {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: JSON.stringify({ accept: button.dataset.accept === "1" }),
        });
        location.reload();
      });
    });
    gate.querySelectorAll<HTMLButtonElement>("[data-report]").forEach((button) => {
      button.addEventListener("click", async () => {
        await fetch(`/api/admin/reports/${button.dataset.report}/close`, { method: "POST" });
        location.reload();
      });
    });
    gate.querySelectorAll<HTMLButtonElement>("[data-build]").forEach((button) => {
      button.addEventListener("click", async () => {
        await fetch(`/api/admin/builds/${button.dataset.build}/hide`, {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: JSON.stringify({ hide: button.dataset.on !== "1" }),
        });
        location.reload();
      });
    });
  }
</script>
