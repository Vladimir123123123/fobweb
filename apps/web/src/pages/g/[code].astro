---
import Base from "../../layouts/Base.astro";

export function getStaticPaths() {
  const code = process.env.ADMIN_PATH || "local-staff-gate";
  return [{ params: { code } }];
}
---
<Base title="Страница" robots="noindex">
  <div id="gate">
    <h1>Такой страницы нет</h1>
    <p>Проверьте адрес.</p>
  </div>
</Base>
<script>
  const gate = document.querySelector("#gate")!;
  const invite = new URLSearchParams(location.search).get("invite");
  let session: Response;
  try {
    session = await fetch("/api/admin/session");
  } catch {
    session = new Response(null, { status: 404 });
  }
  if (session.status === 404 && invite) {
    gate.innerHTML = `<h1>Подтверждение Steam</h1><p>Ссылка одноразовая. После входа через Steam она погаснет, а доступ останется на вашем SteamID.</p><a class="btn" href="/auth/steam?next=${encodeURIComponent(location.pathname + location.search)}">Подтвердить Steam</a>`;
    const me = await fetch("/api/me").then((response) => response.json()).catch(() => null);
    if (me?.user) {
      const redeemed = await fetch("/api/admin/invites/redeem", {
        method: "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify({ token: invite }),
      });
    if (redeemed.ok) location.href = location.pathname;
      else gate.innerHTML = "<h1>Такой страницы нет</h1><p>Проверьте адрес.</p>";
    }
  }
  if (session.ok) {
    const data = await fetch("/api/admin/overview").then((response) => response.json());
    const count = (name: string) => data.sync.find((row: { status: string; count: number }) => row.status === name)?.count ?? 0;
    const esc = (value: string) => value.replace(/[&<>"']/g, (ch) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[ch] ?? ch);
    const queue = (data.assets ?? []).length + (data.reports ?? []).length + data.squads.filter((squad: { status: string }) => squad.status !== "approved" && squad.status !== "rejected").length;
    const meter = (rows: Array<{ label: string; count: number }>) => `<div class="desk-meter">${rows.map((row) => `<p><span>${esc(row.label)}</span><b>${row.count}</b></p>`).join("") || "<p><span>Пока пусто</span><b>0</b></p>"}</div>`;
    gate.innerHTML = `
      <h1>Сводка</h1>
      <nav class="desk-nav" id="desk-nav">
        <button type="button" data-desk="home" class="on">Сводка</button>
        <button type="button" data-desk="guides">Гайды</button>
        <button type="button" data-desk="players">Игроки</button>
        <button type="button" data-desk="squads">Сквады${queue ? ` ${queue}` : ""}</button>
        <button type="button" data-desk="builds">Сборки</button>
        <button type="button" data-desk="quests">Квесты</button>
        <button type="button" data-desk="access">Доступ</button>
      </nav>
      <section class="desk" data-desk="home">
        <div class="stats">
          <div class="stat"><b>${data.liveCis}</b><span>Живые профили СНГ, 7 дней</span></div>
          <div class="stat"><b>${data.views7d}</b><span>Просмотры, 7 дней</span></div>
          <div class="stat"><b>${data.discordClicks7d}</b><span>Клики в Discord, 7 дней</span></div>
          <div class="stat"><b>${data.shares7d}</b><span>Ссылки сборок, 7 дней</span></div>
        </div>
        <p class="note">Входы за 7 дней: ${data.logins7d}. Клики по баннерам сквадов: ${data.squadBannerClicks7d ?? 0}. Сессии синка: живые ${count("active")}, погасшие ${count("expired")}.</p>
        <h2>Откуда пришли</h2>
        ${meter(data.sources.map((row: { source: string; count: number }) => ({ label: row.source, count: row.count })))}
        <h2>По дням</h2>
        ${meter(data.days.map((row: { day: string; count: number }) => ({ label: row.day, count: row.count })))}
        <h2>Запросы в поиске</h2>
        <p class="note">Страницы подписаны под эти формулировки. Ниже — слова, которые поисковик передал вместе с переходом. Google часто их не отдаёт.</p>
        <p class="tags">${(data.searchTags ?? []).map((tag: string) => `<span>${esc(tag)}</span>`).join("")}</p>
        ${meter((data.searchHits ?? []).map((row: { engine: string; query: string; count: number }) => ({ label: `${row.engine ? row.engine + " · " : ""}${row.query || "без текста"}`, count: row.count })))}
      </section>
      <section class="desk" data-desk="guides" hidden>
        <h2>Гайды</h2>
        <p class="note">Пустая строка начинает абзац. Строка с «- » — пункт списка. **так** выделяет слово. Ссылка необязательна: страница сайта вроде /ratings или адрес https://…</p>
        <form id="guide-form" class="guide-form">
          <div class="desk-split">
            <label>Рубрика<input id="guide-rubric" maxlength="40" placeholder="Steam"></label>
            <label>Порядок<input id="guide-sort" type="number" min="0" max="9999" value="0"></label>
          </div>
          <label>Заголовок<input id="guide-title" maxlength="120" required></label>
          <label>Текст<textarea id="guide-body" maxlength="8000" required></textarea></label>
          <label>Ссылка<input id="guide-href" maxlength="200" placeholder="/ratings"></label>
          <label class="check"><input id="guide-hidden" type="checkbox"> Скрыть с сайта</label>
          <div class="row">
            <button class="btn" id="guide-save" type="submit">Добавить</button>
            <button class="btn ghost" id="guide-cancel" type="button" hidden>Отмена</button>
          </div>
          <p id="guide-note" class="note"></p>
        </form>
        <div class="desk-list" id="guide-list"></div>
      </section>
      <section class="desk" data-desk="players" hidden>
        <h2>Игроки в топе</h2>
        <p class="note">По умолчанию все в рейтинге. Здесь можно скрыть или вернуть вручную.</p>
        <div class="desk-list" id="players">
          ${data.players.map((player: { steam_id: string; persona: string | null; hide_leaderboard: boolean; cis_opt_in?: boolean }) => {
            const hidden = Boolean(player.hide_leaderboard) || player.cis_opt_in === false;
            return `<div class="desk-row"><a class="grow" href="/p?id=${player.steam_id}">${player.persona ?? player.steam_id}</a><span class="desk-state">${hidden ? "скрыт" : "в топе"}</span><button class="btn ghost small" data-hide="${player.steam_id}" data-on="${hidden ? "1" : "0"}" type="button">${hidden ? "Показать в топе" : "Скрыть из топа"}</button></div>`;
          }).join("")}
        </div>
      </section>
      <section class="desk" data-desk="squads" hidden>
        <h2>Картинки сквадов</h2>
        <div class="desk-cards" id="assets">${(data.assets ?? []).map((asset: { id: number; kind: string; path: string; discord_url: string; tag: string; name: string }) => `<article class="panel"><img class="${asset.kind === "logo" ? "asset-preview logo" : "asset-preview"}" src="/api/media/${esc(asset.path)}" alt="" /><p>[${esc(asset.tag)}] ${esc(asset.name)} · ${asset.kind === "logo" ? "логотип" : "баннер"}</p>${asset.discord_url ? `<p>${esc(asset.discord_url)}</p>` : ""}<button class="btn small" data-asset="${asset.id}" data-accept="1" type="button">Одобрить</button> <button class="btn ghost small" data-asset="${asset.id}" data-accept="0" type="button">Отклонить</button></article>`).join("") || "<p>Новых картинок нет.</p>"}</div>
        <h2>Жалобы на участников</h2>
        <div class="desk-list" id="reports">${(data.reports ?? []).map((report: { id: number; tag: string; name: string; target_name: string | null; target_steam_id: string; reporter_name: string | null; note: string }) => `<div class="desk-row"><p class="grow">[${esc(report.tag)}] ${esc(report.name)} · на <a href="/p?id=${report.target_steam_id}">${esc(report.target_name ?? report.target_steam_id)}</a> · от ${esc(report.reporter_name ?? "игрока")}<br>${esc(report.note)}</p><button class="btn ghost small" data-report="${report.id}" type="button">Закрыть</button></div>`).join("") || "<p>Открытых жалоб нет.</p>"}</div>
        <h2>Сквады</h2>
        <div class="desk-list" id="squads">${data.squads.map((squad: { id: number; tag: string; name: string; closed: boolean; status: string; has_banner: boolean; has_logo: boolean; persona: string | null }) => `<div class="desk-row"><p class="grow">[${esc(squad.tag)}] ${esc(squad.name)} · ${esc(squad.persona ?? "")}</p><span class="desk-state">${squad.status === "approved" ? "в списке" : squad.status === "rejected" ? "отклонён" : "ждёт проверки"}</span>${squad.status === "approved" ? `<button class="btn ghost small" data-review="${squad.id}" data-accept="0" type="button">Убрать из списка</button>` : `<button class="btn small" data-review="${squad.id}" data-accept="1" type="button">Одобрить сквад</button>`}${squad.closed ? `<span class="desk-state">набор закрыт</span>` : `<button class="btn ghost small" data-close="${squad.id}" type="button">Закрыть набор</button>`}${squad.has_banner ? `<button class="btn ghost small" data-clear="${squad.id}" data-kind="banner" type="button">Снять баннер</button>` : ""}${squad.has_logo ? `<button class="btn ghost small" data-clear="${squad.id}" data-kind="logo" type="button">Скрыть логотип</button>` : ""}</div>`).join("")}</div>
      </section>
      <section class="desk" data-desk="builds" hidden>
        <h2>Сборки</h2>
        <div class="desk-list" id="builds">${(data.builds ?? []).map((build: { id: number; title: string; season: string; hidden: boolean; persona: string | null }) => `<div class="desk-row"><p class="grow"><a href="/b?id=${build.id}">${esc(build.title)}</a> · сезон ${esc(String(build.season))} · ${esc(build.persona ?? "")}</p>${build.hidden ? `<button class="btn ghost small" data-build="${build.id}" data-on="1" type="button">Вернуть</button>` : `<button class="btn ghost small" data-build="${build.id}" data-on="0" type="button">Скрыть</button>`}</div>`).join("") || "<p>Сборок нет.</p>"}</div>
      </section>
      <section class="desk" data-desk="quests" hidden>
        <h2>Квесты</h2>
        <p class="note">Игроки запускают их на <a href="/quests">/quests</a> после входа через Steam. Считаются чужие убийства после кнопки «Начать»: свои и самоубийства не входят. Опыт и очки — сообщества, не карьера в игре. 50 опыта поднимают уровень на 1, потолок 600.</p>
        <div class="row">
          <button class="btn ghost" id="quest-templates" type="button">Шаблоны</button>
          <button class="btn" id="quest-new" type="button">Новый квест</button>
        </div>
        <div id="quest-template-list" class="quest-templates" hidden></div>
        <form id="quest-form" class="guide-form" hidden>
          <div class="desk-split">
            <label>Заголовок<input id="quest-title" maxlength="120" required></label>
            <label>Убийства<input id="quest-kills" type="number" min="1" max="500" value="10" required></label>
          </div>
          <div class="desk-split">
            <label>Сложность<select id="quest-difficulty"><option value="easy">Легкая</option><option value="mid" selected>Средняя</option><option value="hard">Сложная</option></select></label>
            <label>Повтор<select id="quest-repeat"><option value="once">Один раз</option><option value="weekly">Еженедельно</option><option value="monthly">Ежемесячно</option></select></label>
          </div>
          <label>Описание для игроков<textarea id="quest-body" maxlength="500" required></textarea></label>
          <div class="desk-split">
            <label>Опыт<input id="quest-xp" type="number" min="0" max="2000" value="100"></label>
            <label>Очки<input id="quest-coins" type="number" min="0" max="5000" value="40"></label>
          </div>
          <div class="desk-split">
            <label>Не ближе, м<input id="quest-min" type="number" min="0" max="2000" value="0"></label>
            <label>Не дальше, м<input id="quest-max" type="number" min="0" max="2000" value="0"></label>
          </div>
          <label>Оружие, слова через запятую<input id="quest-weapon" maxlength="120" placeholder="пусто — любое"></label>
          <label class="check"><input id="quest-head" type="checkbox"> Только в голову</label>
          <div class="desk-split">
            <label>Начало<input id="quest-start" type="datetime-local"></label>
            <label>Конец<input id="quest-end" type="datetime-local"></label>
          </div>
          <div class="row">
            <button class="btn" id="quest-live" type="submit">Сохранить и запустить</button>
            <button class="btn ghost" id="quest-draft" type="button">Сохранить черновик</button>
            <button class="btn ghost" id="quest-cancel" type="button">Отмена</button>
          </div>
          <p id="quest-note" class="note"></p>
        </form>
        <div class="quest-table" id="quest-admin"></div>
      </section>
      <section class="desk" data-desk="access" hidden>
        <h2>Топ сезона ${esc(String(data.season ?? ""))}</h2>
        <p class="note">В этом сезоне снимков: ${data.seasonPlayers ?? 0}. Кнопка стирает только текущий сезон. Сезон 2 остаётся.</p>
        <button class="btn" id="reset-season" type="button">Обнулить топ сезона</button>
        <p id="reset-note" class="note"></p>
        <h2>Ссылка доступа</h2>
        <button class="btn" id="invite" type="button">Выдать ссылку на 48 часов</button>
        <p id="invite-url"></p>
      </section>
    `;
    const desks = [...gate.querySelectorAll<HTMLElement>(".desk")];
    const openDesk = (name: string) => {
      for (const node of desks) node.hidden = node.dataset.desk !== name;
      gate.querySelectorAll<HTMLButtonElement>("#desk-nav button").forEach((button) => button.classList.toggle("on", button.dataset.desk === name));
      if (name === "quests") loadQuests();
    };
    gate.querySelector("#desk-nav")?.addEventListener("click", (event) => {
      const button = (event.target as Element).closest<HTMLButtonElement>("button");
      if (button?.dataset.desk) openDesk(button.dataset.desk);
    });
    type GuideRow = { id: number; rubric: string; title: string; body: string; href: string; sort_order: number; hidden: boolean };
    const guideRows: GuideRow[] = data.guides ?? [];
    const guideForm = gate.querySelector<HTMLFormElement>("#guide-form");
    const guideList = gate.querySelector("#guide-list");
    const guideNote = gate.querySelector("#guide-note");
    const guideCancel = gate.querySelector<HTMLButtonElement>("#guide-cancel");
    const guideSave = gate.querySelector("#guide-save");
    let editing = 0;
    const field = (id: string) => gate.querySelector<HTMLInputElement | HTMLTextAreaElement>(id);
    const paintGuides = () => {
      if (!guideList) return;
      guideList.innerHTML = guideRows.map((guide) => `<div class="desk-row"><p class="grow"><b>${esc(guide.title)}</b> · ${esc(guide.rubric || "без рубрики")}</p><span class="desk-state">${guide.hidden ? "скрыт" : "на сайте"}</span><button class="btn ghost small" data-guide-edit="${guide.id}" type="button">Править</button><button class="btn ghost small" data-guide-hide="${guide.id}" type="button">${guide.hidden ? "Показать" : "Скрыть"}</button><button class="btn ghost small" data-guide-delete="${guide.id}" type="button">Удалить</button></div>`).join("") || "<p>Пока пусто.</p>";
    };
    const clearGuide = () => {
      editing = 0;
      guideForm?.reset();
      if (guideSave) guideSave.textContent = "Добавить";
      guideCancel?.setAttribute("hidden", "");
    };
    paintGuides();
    guideForm?.addEventListener("submit", async (event) => {
      event.preventDefault();
      const payload = {
        rubric: field("#guide-rubric")?.value ?? "",
        title: field("#guide-title")?.value ?? "",
        body: field("#guide-body")?.value ?? "",
        href: field("#guide-href")?.value ?? "",
        sort: Number(field("#guide-sort")?.value || 0),
        hidden: gate.querySelector<HTMLInputElement>("#guide-hidden")?.checked === true,
      };
      const response = await fetch(editing ? `/api/admin/guides/${editing}` : "/api/admin/guides", {
        method: editing ? "PATCH" : "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify(payload),
      });
      if (!response.ok) {
        if (guideNote) guideNote.textContent = "Не сохранилось. Нужны заголовок и текст.";
        return;
      }
      location.reload();
    });
    guideCancel?.addEventListener("click", clearGuide);
    guideList?.addEventListener("click", async (event) => {
      const button = (event.target as Element).closest<HTMLButtonElement>("button");
      if (!button) return;
      const id = Number(button.dataset.guideEdit || button.dataset.guideHide || button.dataset.guideDelete);
      const guide = guideRows.find((item) => item.id === id);
      if (!guide) return;
      if (button.dataset.guideEdit) {
        editing = guide.id;
        const rubric = field("#guide-rubric");
        const title = field("#guide-title");
        const body = field("#guide-body");
        const href = field("#guide-href");
        const sort = field("#guide-sort");
        const hidden = gate.querySelector<HTMLInputElement>("#guide-hidden");
        if (rubric) rubric.value = guide.rubric || "";
        if (title) title.value = guide.title;
        if (body) body.value = guide.body;
        if (href) href.value = guide.href || "";
        if (sort) sort.value = String(guide.sort_order || 0);
        if (hidden) hidden.checked = Boolean(guide.hidden);
        if (guideSave) guideSave.textContent = "Сохранить";
        guideCancel?.removeAttribute("hidden");
        guideForm?.scrollIntoView({ block: "center" });
        return;
      }
      if (button.dataset.guideHide) {
        await fetch(`/api/admin/guides/${guide.id}`, {
          method: "PATCH",
          headers: { "content-type": "application/json" },
          body: JSON.stringify({ ...guide, sort: guide.sort_order, hidden: !guide.hidden }),
        });
        location.reload();
        return;
      }
      if (button.dataset.guideDelete && confirm(`Удалить «${guide.title}»?`)) {
        await fetch(`/api/admin/guides/${guide.id}`, { method: "DELETE" });
        location.reload();
      }
    });
    gate.querySelector("#reset-season")?.addEventListener("click", async () => {
      if (!confirm(`Обнулить топ сезона ${data.season}? Снимки сезона 2 не удаляются.`)) return;
      const typed = prompt("Для подтверждения напишите ОБНУЛИТЬ");
      if (typed !== "ОБНУЛИТЬ") return;
      const response = await fetch("/api/admin/season/reset", {
        method: "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify({ confirm: "ОБНУЛИТЬ" }),
      });
      const payload = await response.json().catch(() => ({}));
      const note = gate.querySelector("#reset-note");
      if (!response.ok) {
        if (note) note.textContent = payload.error === "season_locked"
          ? "Сезон 2 не обнуляется. На сервере API в GAME_SEASON должен быть 03, затем перезапуск Node."
          : "Не вышло.";
        return;
      }
      if (note) note.textContent = `Снято снимков: ${payload.removed}. Сезон ${payload.season}.`;
      location.reload();
    });
    gate.querySelector("#invite")?.addEventListener("click", async () => {
      const response = await fetch("/api/admin/invites", { method: "POST" });
      const payload = await response.json();
      const node = gate.querySelector("#invite-url");
      if (node) node.textContent = payload.url ?? "";
    });
    gate.querySelectorAll<HTMLButtonElement>("[data-hide]").forEach((button) => {
      button.addEventListener("click", async () => {
        await fetch(`/api/admin/players/${button.dataset.hide}/hide`, {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: JSON.stringify({ hide: button.dataset.on !== "1" }),
        });
        location.reload();
      });
    });
    gate.querySelectorAll<HTMLButtonElement>("[data-close]").forEach((button) => {
      button.addEventListener("click", async () => {
        await fetch(`/api/admin/squads/${button.dataset.close}/close`, { method: "POST" });
        location.reload();
      });
    });
    gate.querySelectorAll<HTMLButtonElement>("[data-review]").forEach((button) => {
      button.addEventListener("click", async () => {
        await fetch(`/api/admin/squads/${button.dataset.review}/review`, {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: JSON.stringify({ accept: button.dataset.accept === "1" }),
        });
        location.reload();
      });
    });
    gate.querySelectorAll<HTMLButtonElement>("[data-clear]").forEach((button) => {
      button.addEventListener("click", async () => {
        await fetch(`/api/admin/squads/${button.dataset.clear}/clear`, {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: JSON.stringify({ kind: button.dataset.kind }),
        });
        location.reload();
      });
    });
    gate.querySelectorAll<HTMLButtonElement>("[data-asset]").forEach((button) => {
      button.addEventListener("click", async () => {
        await fetch(`/api/admin/assets/${button.dataset.asset}/review`, {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: JSON.stringify({ accept: button.dataset.accept === "1" }),
        });
        location.reload();
      });
    });
    gate.querySelectorAll<HTMLButtonElement>("[data-report]").forEach((button) => {
      button.addEventListener("click", async () => {
        await fetch(`/api/admin/reports/${button.dataset.report}/close`, { method: "POST" });
        location.reload();
      });
    });
    gate.querySelectorAll<HTMLButtonElement>("[data-build]").forEach((button) => {
      button.addEventListener("click", async () => {
        await fetch(`/api/admin/builds/${button.dataset.build}/hide`, {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: JSON.stringify({ hide: button.dataset.on !== "1" }),
        });
        location.reload();
      });
    });
    type QuestDraft = { title: string; body: string; kills: number; difficulty: string; repeat: string; xp: number; coins: number; minMeters: number; maxMeters: number; headshot: boolean; weapon: string; status?: string; startsAt?: string | null; endsAt?: string | null; id?: number; started?: number; finished?: number };
    let questEditing = 0;
    let questTemplates: QuestDraft[] = [];
    const q = (id: string) => gate.querySelector<HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement>(id);
    const questForm = gate.querySelector<HTMLFormElement>("#quest-form");
    const questTemplatesBox = gate.querySelector<HTMLElement>("#quest-template-list");
    const localStamp = (value: string | null | undefined) => {
      if (!value) return "";
      const date = new Date(String(value).replace(" ", "T") + (String(value).endsWith("Z") ? "" : "Z"));
      if (Number.isNaN(date.getTime())) return "";
      const pad = (n: number) => String(n).padStart(2, "0");
      return `${date.getFullYear()}-${pad(date.getMonth() + 1)}-${pad(date.getDate())}T${pad(date.getHours())}:${pad(date.getMinutes())}`;
    };
    const fillQuest = (draft: QuestDraft) => {
      questForm?.removeAttribute("hidden");
      if (q("#quest-title")) q("#quest-title")!.value = draft.title;
      if (q("#quest-body")) q("#quest-body")!.value = draft.body;
      if (q("#quest-kills")) q("#quest-kills")!.value = String(draft.kills);
      if (q("#quest-difficulty")) q("#quest-difficulty")!.value = draft.difficulty;
      if (q("#quest-repeat")) q("#quest-repeat")!.value = draft.repeat;
      if (q("#quest-xp")) q("#quest-xp")!.value = String(draft.xp);
      if (q("#quest-coins")) q("#quest-coins")!.value = String(draft.coins);
      if (q("#quest-min")) q("#quest-min")!.value = String(draft.minMeters || 0);
      if (q("#quest-max")) q("#quest-max")!.value = String(draft.maxMeters || 0);
      if (q("#quest-weapon")) q("#quest-weapon")!.value = draft.weapon || "";
      const head = gate.querySelector<HTMLInputElement>("#quest-head");
      if (head) head.checked = Boolean(draft.headshot);
      if (q("#quest-start")) q("#quest-start")!.value = localStamp(draft.startsAt);
      if (q("#quest-end")) q("#quest-end")!.value = localStamp(draft.endsAt);
    };
    const questPayload = (status: string) => ({
      title: q("#quest-title")?.value ?? "",
      body: q("#quest-body")?.value ?? "",
      kills: Number(q("#quest-kills")?.value || 0),
      difficulty: q("#quest-difficulty")?.value || "mid",
      repeat: q("#quest-repeat")?.value || "once",
      xp: Number(q("#quest-xp")?.value || 0),
      coins: Number(q("#quest-coins")?.value || 0),
      minMeters: Number(q("#quest-min")?.value || 0),
      maxMeters: Number(q("#quest-max")?.value || 0),
      weapon: q("#quest-weapon")?.value ?? "",
      headshot: gate.querySelector<HTMLInputElement>("#quest-head")?.checked === true,
      startsAt: q("#quest-start")?.value ? new Date(q("#quest-start")!.value).toISOString() : null,
      endsAt: q("#quest-end")?.value ? new Date(q("#quest-end")!.value).toISOString() : null,
      status,
    });
    const saveQuestForm = async (status: string) => {
      const note = gate.querySelector("#quest-note");
      const payload = questPayload(status);
      const response = await fetch(questEditing ? `/api/admin/quests/${questEditing}` : "/api/admin/quests", {
        method: questEditing ? "PATCH" : "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify(payload),
      });
      if (!response.ok) {
        if (note) note.textContent = "Проверь заголовок, описание и число убийств.";
        return;
      }
      questEditing = 0;
      questForm?.reset();
      questForm?.setAttribute("hidden", "");
      loadQuests();
    };
    const loadQuests = async () => {
      const board = await fetch("/api/admin/quests").then((response) => response.ok ? response.json() : null);
      const list = gate.querySelector("#quest-admin");
      if (!board || !list || !questTemplatesBox) return;
      questTemplates = board.templates ?? [];
      const diff: Record<string, string> = { easy: "Легкая", mid: "Средняя", hard: "Сложная" };
      const repeat: Record<string, string> = { once: "Один раз", weekly: "Еженедельно", monthly: "Ежемесячно" };
      questTemplatesBox.innerHTML = questTemplates.map((item, index) => `<article class="panel"><p class="eyebrow">${diff[item.difficulty] || "Средняя"}</p><h3>${esc(item.title)}</h3><p>${esc(item.body)}</p><p class="note">${item.kills} убийств · ${item.xp} опыта · ${item.coins} очков</p><button class="btn small" data-template="${index}" type="button">Использовать как черновик</button></article>`).join("");
      list.innerHTML = board.quests.map((item: QuestDraft) => `<article class="quest-line"><div><b>${esc(item.title)}</b><p>${esc(item.body)}</p></div><p><span class="pill">${item.status === "live" ? "Идёт" : "Черновик"}</span> <span class="pill">${diff[item.difficulty] || ""}</span> <span class="pill">${repeat[item.repeat] || ""}</span></p><p class="note">${item.kills} убийств${item.headshot ? " · в голову" : ""}${item.minMeters ? ` · от ${item.minMeters} м` : ""}${item.maxMeters ? ` · до ${item.maxMeters} м` : ""}${item.weapon ? ` · ${esc(item.weapon)}` : ""}</p><p>Начато ${item.started || 0}<br>Завершено ${item.finished || 0}</p><p>${item.xp} опыта<br>${item.coins} очков</p><p><button class="btn ghost small" data-quest-edit="${item.id}" type="button">Изменить</button> <button class="btn ghost small" data-quest-delete="${item.id}" type="button">Удалить</button></p></article>`).join("") || "<p>Квестов пока нет. Шаблон можно запустить как есть.</p>";
      list.querySelectorAll<HTMLButtonElement>("[data-quest-edit]").forEach((button) => {
        button.addEventListener("click", () => {
          const found = (board.quests as QuestDraft[]).find((item) => item.id === Number(button.dataset.questEdit));
          if (!found) return;
          questEditing = Number(found.id);
          fillQuest(found);
        });
      });
      list.querySelectorAll<HTMLButtonElement>("[data-quest-delete]").forEach((button) => {
        button.addEventListener("click", async () => {
          await fetch(`/api/admin/quests/${button.dataset.questDelete}`, { method: "DELETE" });
          loadQuests();
        });
      });
    };
    gate.querySelector("#quest-templates")?.addEventListener("click", () => {
      if (!questTemplatesBox) return;
      questTemplatesBox.hidden = !questTemplatesBox.hidden;
    });
    questTemplatesBox?.addEventListener("click", (event) => {
      const button = (event.target as Element).closest<HTMLButtonElement>("[data-template]");
      if (!button) return;
      const draft = questTemplates[Number(button.dataset.template)];
      if (!draft) return;
      questEditing = 0;
      fillQuest(draft);
    });
    gate.querySelector("#quest-new")?.addEventListener("click", () => {
      questEditing = 0;
      questForm?.reset();
      questForm?.removeAttribute("hidden");
    });
    gate.querySelector("#quest-cancel")?.addEventListener("click", () => {
      questEditing = 0;
      questForm?.reset();
      questForm?.setAttribute("hidden", "");
    });
    questForm?.addEventListener("submit", (event) => {
      event.preventDefault();
      saveQuestForm("live");
    });
    gate.querySelector("#quest-draft")?.addEventListener("click", () => saveQuestForm("draft"));
  }
</script>
