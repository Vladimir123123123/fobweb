---
import Base from "../layouts/Base.astro";
---
<Base title="Квесты — WARDOGS СНГ" description="Квесты сервера FOB. После входа через Steam убийства на сервере приносят опыт и очки сообщества.">
  <p class="eyebrow">Сообщество</p>
  <h1>Квесты</h1>
  <div class="quest-intro glass-card">
    <p>Запусти квест и выполняй его на сервере FOB. Когда убийства собраны — нажми «Забрать награду»: опыт и очки приходят после неё. Повтор того же квеста — через 24 часа.</p>
    <p>Очки за квест идут вам и, если вы в скваде, столько же в казну. Очки с сида и «Обновить статистику» — только личные.</p>
    <ul class="quest-combat">
      <li>Килл <b class="hi">+0.2</b> · стрик без смерти <b class="hi">+10%</b></li>
      <li>Хедшот <b class="hi">+0.5</b> · смерть <b class="hi">−0.7</b> · TK <b class="hi">−10</b></li>
    </ul>
    <p class="note">Личный VIP — в магазине ниже. Клановый слот берёт лидер или зам из казны.</p>
  </div>
  <section id="quest-rank" class="quest-rank"></section>
  <h2>Магазин</h2>
  <p class="note" id="shop-rule"></p>
  <p id="shop-note" class="note"></p>
  <section id="shop-list" class="shop-list"></section>
  <section id="quest-list" class="quest-list"></section>
</Base>
<script>
  const rank = document.querySelector<HTMLElement>("#quest-rank")!;
  const list = document.querySelector<HTMLElement>("#quest-list")!;
  const shop = document.querySelector<HTMLElement>("#shop-list")!;
  const shopRule = document.querySelector<HTMLElement>("#shop-rule")!;
  const shopNote = document.querySelector<HTMLElement>("#shop-note")!;
  const esc = (value: string) => value.replace(/[&<>"']/g, (ch) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[ch] ?? ch);
  const diff: Record<string, string> = { easy: "Легкая", mid: "Средняя", hard: "Сложная" };
  const repeat: Record<string, string> = { once: "Раз в 24 ч", weekly: "Раз в 24 ч", monthly: "Раз в 24 ч" };
  type Quest = {
    id: number; title: string; body: string; kills: number; difficulty: string; repeat: string; retryIn?: number;
    xp: number; coins: number; minMeters: number; maxMeters: number; headshot: boolean; weapon: string;
    state: string; progress: number;
  };
  // Объёмные иконки наград: круг с бликом и свечением, значок внутри
  const rewardGlyph: Record<string, string> = {
    xp: `<path d="m6 14 6-6 6 6M6 19l6-6 6 6"/>`,
    coin: `<circle cx="12" cy="12" r="5.500"/><path d="M12 9v6M10 10.500c.4-.8 1.200-1 2-1s1.800.4 1.800 1.200c0 1.800-3.800 1-3.800 2.800 0 .8.900 1.300 2 1.300s1.700-.3 2-1"/>`,
  };
  const reward = (kind: string, value: number, label: string) => `<span class="reward ${kind}"><i aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">${rewardGlyph[kind] ?? ""}</svg></i><b>${value}</b><small>${label}</small></span>`;
  const rules = (quest: Quest) => {
    const lines = [`${quest.kills} убийств`];
    if (quest.weapon) lines.push(quest.weapon);
    if (quest.minMeters) lines.push(`не ближе ${quest.minMeters} м`);
    if (quest.maxMeters) lines.push(`не дальше ${quest.maxMeters} м`);
    if (quest.headshot) lines.push("только в голову");
    lines.push("свои и самоубийства не считаются");
    return lines.map((line) => `<li>${esc(line)}</li>`).join("");
  };
  const paint = (data: { signedIn?: boolean; level?: number; into?: number; need?: number; coins?: number; maxed?: boolean; quests?: Quest[] }) => {
    const level = Number(data.level) || 0;
    const into = Number(data.into) || 0;
    const need = Number(data.need) || 50;
    const width = data.maxed ? 100 : Math.max(0, Math.min(100, Math.round((into / need) * 100)));
    rank.innerHTML = data.signedIn
      ? `<p class="eyebrow">Уровень сообщества</p><div class="quest-score"><b>${level}</b><span>из 600</span><b class="hi">${Number(data.coins || 0).toFixed(1).replace(/\.0$/, "")}</b><span>очков</span></div><div class="rank-bar" aria-hidden="true"><span style="width:${width}%"></span></div><p class="note">${data.maxed ? "Потолок уровня." : `До следующего уровня <b class="hi">${need - into}</b> опыта.`} <b class="hi">50</b> опыта — один уровень.</p>`
      : `<p>Чтобы взять квест и потратить очки, войди через Steam.</p><a class="btn-primary" href="/auth/steam?next=/quests">Войти через Steam</a>`;
    const quests = data.quests ?? [];
    list.innerHTML = quests.map((quest) => {
      const cooldown = quest.state === "cooldown";
      const ready = quest.state === "ready";
      const active = quest.state === "active" || ready;
      const hoursLeft = cooldown ? Math.max(1, Math.ceil((Number(quest.retryIn) || 0) / 3600)) : 0;
      const width = Math.max(0, Math.min(100, Math.round((quest.progress / Math.max(quest.kills, 1)) * 100)));
      const action = cooldown
        ? `<span class="pill now">Перезарядка ~${hoursLeft} ч</span>`
        : ready
          ? `<button class="btn small" data-claim="${quest.id}" type="button">Забрать награду</button>`
          : active
            ? `<span class="pill">${quest.progress} / ${quest.kills}</span>`
            : data.signedIn
              ? `<button class="btn small" data-start="${quest.id}" type="button">Начать</button>`
              : "";
      const check = `<span class="quest-check" role="img" aria-label="Выполнен"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12.500 4.500 4.500L19 7.500"/></svg></span>`;
      const state = cooldown ? "is-done" : ready ? "is-ready" : active ? "is-active" : "";
      return `<article class="quest ${state}">
        <header class="quest-head">
          <h2>${esc(quest.title)}</h2>
          ${cooldown ? check : ""}
        </header>
        <p class="quest-body">${esc(quest.body)}</p>
        <p class="quest-pills"><span class="pill">${diff[quest.difficulty] || "Средняя"}</span><span class="pill">${repeat[quest.repeat] || "Раз в 24 ч"}</span></p>
        <ul>${rules(quest)}</ul>
        <div class="rewards">${reward("xp", quest.xp, "опыта")}${reward("coin", quest.coins, "очков")}</div>
        <div class="quest-foot">
          <div class="rank-bar${cooldown ? " full" : ""}" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="${cooldown ? 100 : width}"><span style="width:${cooldown ? 100 : width}%"></span></div>
          ${action}
        </div>
      </article>`;
    }).join("") || "<p>Сейчас нет запущенных квестов.</p>";
  };
  const load = async () => {
    const response = await fetch("/api/quests");
    if (!response.ok) {
      list.innerHTML = "<p>Квесты сейчас не открываются.</p>";
      return;
    }
    paint(await response.json());
  };
  type Product = { id: number; title: string; body: string; price: number; kind: string; days: number };
  const paintShop = (data: { signedIn?: boolean; products?: Product[]; seedCoins?: number; seedCap?: number; seedBelow?: number; seedToday?: number; statCoins?: number; statToday?: boolean }) => {
    const perMinute = Number(data.seedCoins) || 0;
    const cap = Number(data.seedCap) || 0;
    const below = Number(data.seedBelow) || 20;
    const word = (count: number) => {
      const mod = count % 10;
      const teen = count % 100;
      if (mod === 1 && teen !== 11) return "очко";
      if (mod >= 2 && mod <= 4 && (teen < 12 || teen > 14)) return "очка";
      return "очков";
    };
    const statCoins = Number(data.statCoins) || 10;
    shopRule.textContent = perMinute
      ? `Пока на сервере меньше ${below} человек, минута в игре даёт ${perMinute} ${word(perMinute)}. В день не больше ${cap}. Кнопка «Обновить статистику» раз в сутки даёт ${statCoins} ${word(statCoins)}. Месяц такого сида не закрывает VIP целиком, остальное добирают квесты, поэтому оплата в тикете Discord быстрее.`
      : `Сид сейчас не начисляет очки. Кнопка «Обновить статистику» раз в сутки даёт ${statCoins} ${word(statCoins)}.`;
    if (data.signedIn) {
      shopRule.textContent += ` Сегодня с сида: ${Number(data.seedToday) || 0} из ${cap}. Обновление статистики: ${data.statToday ? "уже начислено" : "ещё нет"}.`;
    }
    const products = data.products ?? [];
    shop.innerHTML = products.map((product) => `<article class="shop-item"><div><h2>${esc(product.title)}</h2><p>${esc(product.body)}</p></div><div class="rewards">${reward("coin", product.price, "очков")}${product.days ? `<span class="reward days"><b>${product.days}</b><small>дней</small></span>` : ""}</div><div>${data.signedIn ? `<button class="btn small" data-buy="${product.id}" data-kind="${esc(product.kind)}" type="button">Купить</button>` : `<a class="btn small" href="/auth/steam?next=/quests">Войти и купить</a>`}</div></article>`).join("") || "<p>В магазине пока пусто.</p>";
  };
  const loadShop = async () => {
    const response = await fetch("/api/shop");
    if (!response.ok) {
      shop.innerHTML = "<p>Магазин сейчас не открывается.</p>";
      return;
    }
    paintShop(await response.json());
  };
  const shopErrors: Record<string, string> = {
    discord: "Привяжи Discord в своём профиле, чтобы роль Спонсор нашлась.",
    poor: "Не хватает очков.",
    closed: "Этого товара уже нет.",
  };
  shop.addEventListener("click", async (event) => {
    const button = (event.target as Element).closest<HTMLButtonElement>("[data-buy]");
    if (!button) return;
    button.disabled = true;
    shopNote.textContent = "";
    const response = await fetch(`/api/shop/${button.dataset.buy}`, { method: "POST" });
    if (response.status === 401) {
      location.href = "/auth/steam?next=/quests";
      return;
    }
    if (!response.ok) {
      const body = await response.json().catch(() => ({}));
      shopNote.textContent = shopErrors[String(body.error)] || "Покупка не прошла.";
      button.disabled = false;
      return;
    }
    const kind = button.dataset.kind || "";
    paintShop(await response.json());
    shopNote.textContent = kind === "note" ? "Покупка записана." : "Покупка прошла. Роль Спонсор появится в Discord в течение минуты.";
    load();
  });
  const questErrors: Record<string, string> = {
    wait: "Квест ещё не выполнен.",
    done: "Награда по этому квесту уже получена.",
    ready: "Квест уже выполнен. Нажми «Забрать награду».",
    cooldown: "Квест на перезарядке. Повторить можно через 24 часа после награды.",
    closed: "Этот квест уже закрыт.",
  };
  list.addEventListener("click", async (event) => {
    const claim = (event.target as Element).closest<HTMLButtonElement>("[data-claim]");
    const button = claim ?? (event.target as Element).closest<HTMLButtonElement>("[data-start]");
    if (!button) return;
    button.disabled = true;
    const id = button.dataset.claim || button.dataset.start;
    const path = button.dataset.claim ? "claim" : "start";
    const response = await fetch(`/api/quests/${id}/${path}`, { method: "POST" });
    if (response.status === 401) {
      location.href = "/auth/steam?next=/quests";
      return;
    }
    if (response.ok) paint(await response.json());
    else {
      const body = await response.json().catch(() => ({}));
      button.disabled = false;
      button.insertAdjacentHTML("afterend", `<p class="note">${esc(questErrors[String(body.error)] || "Не вышло.")}</p>`);
    }
  });
  load();
  loadShop();
</script>
