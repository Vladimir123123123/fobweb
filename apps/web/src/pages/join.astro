---
import Base from "../layouts/Base.astro";

const code = "8bc9a68b-e41c-4801-988f-a594e48762b6";
---
<Base title="Зайти на сервер FOB" description="Подключение к серверу FOB #1 одной кнопкой через Steam." robots="noindex">
  <p class="eyebrow">Сервер</p>
  <h1>Зайти на FOB #1</h1>
  <p class="lead">Кнопка открывает WARDOGS в Steam и сразу подключает к серверу. Если не вышло, код ниже вставляют в Join by ID.</p>
  <p class="join-code" id="join-code">{code}</p>
  <p>
    <button class="btn" id="join-go" type="button">Подключиться напрямую</button>
    <button class="btn ghost" id="join-copy" type="button">Скопировать код</button>
  </p>
  <p class="join-note" id="join-note"></p>
  <ol class="join-steps">
    <li>Deploy → Community.</li>
    <li>Слева внизу — Join by ID.</li>
    <li>Вставь код и нажми Lookup.</li>
    <li>Join Match.</li>
  </ol>
</Base>
<script define:vars={{ code }}>
  const go = document.querySelector("#join-go");
  const copy = document.querySelector("#join-copy");
  const note = document.querySelector("#join-note");

  async function copyCode() {
    try {
      await navigator.clipboard.writeText(code);
      return true;
    } catch {
      const field = document.querySelector("#join-code");
      if (field) {
        const range = document.createRange();
        range.selectNodeContents(field);
        const selection = window.getSelection();
        selection?.removeAllRanges();
        selection?.addRange(range);
      }
      return false;
    }
  }

  async function join() {
    if (!go) return;
    go.disabled = true;
    if (note) note.textContent = "Открываю Steam…";
    try {
      const response = await fetch("/api/server/join-link", { cache: "no-store" });
      const data = await response.json();
      if (!response.ok || !/^steam:\/\/joinlobby\/\d+\/\d+$/.test(data.link || "")) throw new Error("no link");
      if (note) {
        note.innerHTML = 'Steam открывает WARDOGS. Не открылось? <a href="' + data.link + '">Открыть в Steam</a> или зайди по коду ниже.';
      }
      window.location.href = data.link;
    } catch {
      const copied = await copyCode();
      if (note) note.textContent = copied
        ? "Прямое подключение сейчас недоступно. Код скопирован: вставь его в Join by ID."
        : "Прямое подключение сейчас недоступно. Выдели код выше и вставь его в Join by ID.";
    } finally {
      setTimeout(() => { go.disabled = false; }, 3000);
    }
  }

  go?.addEventListener("click", join);
  copy?.addEventListener("click", async () => {
    const copied = await copyCode();
    if (note) note.textContent = copied ? "Код скопирован." : "Выдели код выше и скопируй его.";
  });
  if (new URLSearchParams(location.search).get("go") === "1") join();
</script>
