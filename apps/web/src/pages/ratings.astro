---
import Base from "../layouts/Base.astro";
---
<Base title="Рейтинг СНГ — WARDOGS СНГ">
  <p class="eyebrow">Игроки со Steam</p>
  <h1>Рейтинг СНГ</h1>
  <p class="lead">В топе все, кто вошёл или привязан с Discord — пока сами не скрыли профиль. Цифры — из последнего снимка; без снимка строка пустая, пока карьера не подтянется.</p>
  <div class="row">
    <label>Сортировка
      <select id="sort">
        <option value="level">Уровень</option>
        <option value="xp">Опыт</option>
        <option value="value">Стоимость</option>
        <option value="cash">Деньги</option>
        <option value="gold">Золото</option>
        <option value="unlocks">Открытия</option>
        <option value="assault">Штурм</option>
        <option value="medic">Медик</option>
        <option value="recon">Разведка</option>
        <option value="support">Поддержка</option>
        <option value="driver">Водитель</option>
        <option value="pilot">Пилот</option>
      </select>
    </label>
    <label>Поиск<input id="q" placeholder="Ник" /></label>
    <button class="btn" id="me" type="button">Показать меня</button>
  </div>
  <p class="rank-key">
    <span><i class="r1"></i>1</span>
    <span><i class="r5"></i>2–5</span>
    <span><i class="r10"></i>6–10</span>
    <span><i class="r25"></i>11–25</span>
    <span><i class="r50"></i>26–50</span>
    <span><i class="r100"></i>51–100</span>
    <span><i class="r200"></i>101–200</span>
  </p>
  <p class="note" id="rating-note"></p>
  <div class="scroll panel">
    <table class="ratings">
      <thead>
        <tr>
          <th>#</th>
          <th>Игрок</th>
          <th title="Уровень"><img class="th-ico th-ico-level" src="/art/t_ui_icon_careerlevel_600.webp" alt="Уровень" width="20" height="20" /></th>
          <th>Опыт</th>
          <th>Стоим.</th>
          <th>Деньги</th>
          <th title="Золото"><img class="th-ico th-ico-gold" src="/art/t_ui_goldbars_icon.webp" alt="Золото" width="20" height="20" /></th>
          <th>Откр.</th>
          <th title="Штурм"><img class="th-ico th-ico-role" src="/art/t_ui_icon_role_infantry.webp" alt="Штурм" width="18" height="18" /></th>
          <th title="Медик"><img class="th-ico th-ico-role" src="/art/t_ui_icon_role_medic.webp" alt="Медик" width="18" height="18" /></th>
          <th title="Разведка"><img class="th-ico th-ico-role" src="/art/t_ui_icon_role_recon.webp" alt="Разведка" width="18" height="18" /></th>
          <th title="Поддержка"><img class="th-ico th-ico-role" src="/art/t_ui_icon_role_support.webp" alt="Поддержка" width="18" height="18" /></th>
          <th title="Водитель"><img class="th-ico th-ico-role" src="/art/t_ui_icon_role_driver.webp" alt="Водитель" width="18" height="18" /></th>
          <th title="Пилот"><img class="th-ico th-ico-role" src="/art/t_ui_icon_role_pilot.webp" alt="Пилот" width="18" height="18" /></th>
        </tr>
      </thead>
      <tbody id="rows"></tbody>
    </table>
  </div>
</Base>
<script>
  const sort = document.querySelector<HTMLSelectElement>("#sort")!;
  const q = document.querySelector<HTMLInputElement>("#q")!;
  const rows = document.querySelector("#rows")!;
  const note = document.querySelector("#rating-note")!;
  const money = (value: number | null) => value === null || value === undefined ? "—" : `$${new Intl.NumberFormat("ru-RU").format(value)}`;
  async function load() {
    const response = await fetch(`/api/ratings?sort=${sort.value}&q=${encodeURIComponent(q.value)}`);
    if (!response.ok) {
      note.textContent = "Рейтинг сейчас не открывается.";
      return;
    }
    const data = await response.json();
    const sync = new URLSearchParams(location.search).get("sync");
    const syncNote = sync === "wait"
      ? "Обновляем статистику. Не закрывай вкладку."
      : sync === "game_running"
        ? "Закрой WARDOGS и в профиле нажми «Обновить через Steam»."
        : sync === "access_denied"
          ? "Вход отменён."
          : sync === "expired"
            ? "Вход не завершился. Нажми «Войти через Steam» ещё раз."
            : sync
              ? "Цифры не пришли. Открой свой профиль и нажми «Обновить через Steam»."
              : "";
    note.textContent = syncNote || `Сезон ${data.season}. Строк: ${data.players.length}.`;
    const tierOf = (place: number) => place === 1 ? "r1" : place <= 5 ? "r5" : place <= 10 ? "r10" : place <= 25 ? "r25" : place <= 50 ? "r50" : place <= 100 ? "r100" : "r200";
    const esc = (value: string) => value.replace(/[&<>"']/g, (ch) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[ch] ?? ch);
    const ranked = q.value.trim() === "";
    rows.innerHTML = data.players.map((player: Record<string, string | number | null>, index: number) => {
      const place = index + 1;
      const name = String(player.persona ?? player.steam_id);
      const portrait = typeof player.avatar === "string" && player.avatar.startsWith("https://") ? player.avatar : "";
      const tier = ranked ? tierOf(place) : "";
      return `
      <tr id="p-${player.steam_id}">
        <td>${place}</td>
        <td><a class="who ${tier}" href="/p?id=${player.steam_id}"><span class="ring">${portrait ? `<img src="${esc(portrait)}" alt="" />` : `<span>${esc(name.slice(0, 1))}</span>`}</span>${esc(name)}</a></td>
        <td>${player.wardog_level ?? "—"}</td>
        <td>${player.xp ?? "—"}</td>
        <td>${money(player.account_value as number | null)}</td>
        <td>${money(player.cash as number | null)}</td>
        <td>${player.gold ?? "—"}</td>
        <td>${player.unlocks ?? "—"}</td>
        <td>${player.role_assault ?? "—"}</td>
        <td>${player.role_medic ?? "—"}</td>
        <td>${player.role_recon ?? "—"}</td>
        <td>${player.role_support ?? "—"}</td>
        <td>${player.role_driver ?? "—"}</td>
        <td>${player.role_pilot ?? "—"}</td>
      </tr>`;
    }).join("") || `<tr><td colspan="14">Пока нет снимков. Топ заполнится после синхронизации вошедших игроков.</td></tr>`;
  }
  sort.addEventListener("change", load);
  q.addEventListener("change", load);
  document.querySelector("#me")?.addEventListener("click", async () => {
    const me = await fetch("/api/me").then((response) => response.json()).catch(() => null);
    const id = me?.user?.steam_id;
    if (!id) {
      location.href = "/auth/steam?next=/ratings";
      return;
    }
    document.getElementById(`p-${id}`)?.scrollIntoView({ block: "center" });
  });
  load();
  const waitParams = new URLSearchParams(location.search);
  if (waitParams.get("sync") === "wait") {
    note.textContent = "Обновляем статистику. Не закрывай вкладку.";
    const job = waitParams.get("job") || "";
    (async () => {
      for (let i = 0; i < 45; i++) {
        const data = await fetch(`/api/auth/status?job=${encodeURIComponent(job)}`).then((r) => r.json()).catch(() => null);
        if (!data || data.status === "pending") {
          await new Promise((ok) => setTimeout(ok, 2000));
          continue;
        }
        const path = data.next || "/ratings";
        const url = new URL(path, location.origin);
        if (data.status === "ok") {
          if (data.flag) url.searchParams.set("sync", data.flag);
          else url.searchParams.delete("sync");
          if (data.steamId && !url.searchParams.get("id")) url.searchParams.set("id", data.steamId);
        } else {
          url.searchParams.set("sync", data.sync || "expired");
        }
        url.searchParams.delete("job");
        location.replace(url.pathname + url.search);
        return;
      }
      location.replace("/ratings?sync=expired");
    })();
  }
</script>
