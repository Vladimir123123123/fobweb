---
import Base from "../layouts/Base.astro";
---
<Base title="Рейтинг СНГ — WARDOGS СНГ" wide>
  <header class="ladder-head">
    <h1>Рейтинг <small id="season-label">сезон 03</small></h1>
  </header>
  <div class="ladder-bar">
    <label>Сортировка
      <select id="sort">
        <option value="level">Уровень</option>
        <option value="xp">Опыт</option>
        <option value="value">Стоимость</option>
        <option value="cash">Деньги</option>
        <option value="gold">Золото</option>
        <option value="unlocks">Открытия</option>
        <option value="assault">Штурм</option>
        <option value="medic">Медик</option>
        <option value="recon">Разведка</option>
        <option value="support">Поддержка</option>
        <option value="driver">Водитель</option>
        <option value="pilot">Пилот</option>
        <option value="kills">Убийства</option>
        <option value="deaths">Смерти</option>
        <option value="kd">К/Д</option>
      </select>
    </label>
    <label>Поиск<input id="q" placeholder="Ник" /></label>
    <button class="btn ghost" id="me" type="button">Найти себя</button>
  </div>
  <p class="note" id="rating-note"></p>
  <div class="podium" id="podium"></div>
  <div class="ladder">
    <table class="ratings">
      <thead>
        <tr>
          <th>#</th>
          <th>Игрок</th>
          <th title="Уровень"><img class="th-ico th-ico-level" src="/art/t_ui_icon_careerlevel_600.webp" alt="Уровень" width="16" height="16" /></th>
          <th title="Опыт">XP</th>
          <th title="Стоимость">$</th>
          <th title="Деньги">Кэш</th>
          <th title="Золото"><img class="th-ico th-ico-gold" src="/art/t_ui_goldbars_icon.webp" alt="Золото" width="16" height="16" /></th>
          <th title="Открытия">+</th>
          <th title="Штурм"><img class="th-ico th-ico-role" src="/art/t_ui_icon_role_infantry.webp" alt="Штурм" width="18" height="18" /></th>
          <th title="Медик"><img class="th-ico th-ico-role" src="/art/t_ui_icon_role_medic.webp" alt="Медик" width="18" height="18" /></th>
          <th title="Разведка"><img class="th-ico th-ico-role" src="/art/t_ui_icon_role_recon.webp" alt="Разведка" width="18" height="18" /></th>
          <th title="Поддержка"><img class="th-ico th-ico-role" src="/art/t_ui_icon_role_support.webp" alt="Поддержка" width="18" height="18" /></th>
          <th title="Водитель"><img class="th-ico th-ico-role" src="/art/t_ui_icon_role_driver.webp" alt="Водитель" width="18" height="18" /></th>
          <th title="Пилот"><img class="th-ico th-ico-role" src="/art/t_ui_icon_role_pilot.webp" alt="Пилот" width="18" height="18" /></th>
          <th title="Убийства на сервере">У</th>
          <th title="Смерти на сервере">С</th>
          <th title="Убийства на смерть">К/Д</th>
          <th title="Последняя фракция на сервере">Фр</th>
        </tr>
      </thead>
      <tbody id="rows"></tbody>
    </table>
  </div>
</Base>
<script>
  const sort = document.querySelector<HTMLSelectElement>("#sort")!;
  const q = document.querySelector<HTMLInputElement>("#q")!;
  const rows = document.querySelector("#rows")!;
  const podium = document.querySelector<HTMLElement>("#podium")!;
  const note = document.querySelector("#rating-note")!;
  const money = (value: number | null) => value === null || value === undefined ? "—" : `$${new Intl.NumberFormat("ru-RU").format(value)}`;
  const num = (value: unknown) => value === null || value === undefined || value === "" ? "—" : new Intl.NumberFormat("ru-RU").format(Number(value));
  const columns: Record<string, number> = { level: 3, xp: 4, value: 5, cash: 6, gold: 7, unlocks: 8, assault: 9, medic: 10, recon: 11, support: 12, driver: 13, pilot: 14, kills: 15, deaths: 16, kd: 17 };
  const labels: Record<string, string> = { level: "уровень", xp: "опыт", value: "стоимость", cash: "деньги", gold: "золото", unlocks: "открытия", assault: "штурм", medic: "медик", recon: "разведка", support: "поддержка", driver: "водитель", pilot: "пилот", kills: "убийства", deaths: "смерти", kd: "к/д" };
  const fields: Record<string, string> = { level: "wardog_level", xp: "xp", value: "account_value", cash: "cash", gold: "gold", unlocks: "unlocks", assault: "role_assault", medic: "role_medic", recon: "role_recon", support: "role_support", driver: "role_driver", pilot: "role_pilot", kills: "server_kills", deaths: "server_deaths", kd: "server_kd" };
  const esc = (value: string) => value.replace(/[&<>"']/g, (ch) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[ch] ?? ch);
  const tierOf = (place: number) => place === 1 ? "r1" : place <= 5 ? "r5" : place <= 10 ? "r10" : place <= 25 ? "r25" : place <= 50 ? "r50" : place <= 100 ? "r100" : "r200";
  function face(player: Record<string, string | number | null>) {
    const name = String(player.persona ?? player.steam_id);
    const portrait = typeof player.avatar === "string" && player.avatar.startsWith("https://") ? player.avatar : "";
    return `<span class="ring">${portrait ? `<img src="${esc(portrait)}" alt="" />` : `<span>${esc(name.slice(0, 1))}</span>`}</span>`;
  }
  function statText(player: Record<string, string | number | null>, key: string) {
    const raw = player[fields[key]];
    if (key === "value" || key === "cash") return money(raw as number | null);
    if (key === "kd") {
      if (raw === null || raw === undefined || raw === "") return "—";
      const value = Number(raw);
      return Number.isFinite(value) ? value.toLocaleString("ru-RU", { minimumFractionDigits: 2, maximumFractionDigits: 2 }) : "—";
    }
    return num(raw);
  }
  async function load() {
    const response = await fetch(`/api/ratings?sort=${sort.value}&q=${encodeURIComponent(q.value)}`);
    if (!response.ok) {
      note.textContent = "Рейтинг сейчас не открывается.";
      return;
    }
    const data = await response.json();
    const sync = new URLSearchParams(location.search).get("sync");
    const syncNote = sync === "wait"
      ? "Обновляем статистику. Не закрывай вкладку."
      : sync === "game_running"
        ? "Закрой WARDOGS и в профиле нажми «Снять из игры»."
        : sync === "access_denied"
          ? "Вход отменён."
          : sync === "expired"
            ? "Вход не завершился. Нажми «Войти через Steam» ещё раз."
            : sync
              ? "Цифры не пришли. Открой свой профиль и нажми «Снять из игры»."
              : "";
    const seasonLabel = document.querySelector("#season-label");
    if (seasonLabel && data.season) seasonLabel.textContent = `сезон ${data.season}`;
    note.textContent = syncNote || `Сезон ${data.season}. В списке ${data.players.length}.`;
    const ranked = q.value.trim() === "";
    const hot = columns[sort.value] ?? 3;
    document.querySelectorAll<HTMLTableCellElement>(".ladder th").forEach((cell, index) => {
      cell.classList.toggle("hot", index + 1 === hot);
    });
    const players = data.players as Array<Record<string, string | number | null>>;
    podium.dataset.n = ranked && players.length ? String(Math.min(players.length, 3)) : "0";
    podium.innerHTML = ranked ? players.slice(0, 3).map((player, index) => {
      const place = index + 1;
      const name = String(player.persona ?? player.steam_id);
      return `<a class="pod pod-${place} ${tierOf(place)}" href="/p?id=${player.steam_id}">
        <em>${place}</em>
        ${face(player)}
        <strong>${esc(name)}</strong>
        <b>${statText(player, sort.value)}</b>
        <small>${labels[sort.value] ?? ""}</small>
      </a>`;
    }).join("") : "";
    rows.innerHTML = players.map((player, index) => {
      const place = index + 1;
      const name = String(player.persona ?? player.steam_id);
      const tier = ranked ? tierOf(place) : "";
      const stats = ["level", "xp", "value", "cash", "gold", "unlocks", "assault", "medic", "recon", "support", "driver", "pilot", "kills", "deaths", "kd"];
      const faction = String(player.server_faction ?? "").trim();
      return `
      <tr class="${tier}" id="p-${player.steam_id}">
        <td class="place">${place}</td>
        <td><a class="who ${tier}" href="/p?id=${player.steam_id}">${face(player)}<span class="name">${esc(name)}</span></a></td>
        ${stats.map((key, statIndex) => `<td class="${statIndex + 3 === hot ? "hot" : ""}">${statText(player, key)}</td>`).join("")}
        <td>${faction ? esc(faction) : "—"}</td>
      </tr>`;
    }).join("") || `<tr><td colspan="18">Пока никого нет. Список заполнится, когда игроки снимут карьеру.</td></tr>`;
  }
  sort.addEventListener("change", load);
  let pending = 0;
  q.addEventListener("input", () => {
    window.clearTimeout(pending);
    pending = window.setTimeout(load, 180);
  });
  document.querySelector("#me")?.addEventListener("click", async () => {
    const me = await fetch("/api/me").then((response) => response.json()).catch(() => null);
    const id = me?.user?.steam_id;
    if (!id) {
      location.href = "/auth/steam?next=/ratings";
      return;
    }
    if (q.value) {
      q.value = "";
      await load();
    }
    const row = document.getElementById(`p-${id}`);
    if (!row) {
      note.textContent = "Тебя нет в этом списке: профиль скрыт или ещё без входа.";
      return;
    }
    document.querySelectorAll("tr.is-me").forEach((item) => item.classList.remove("is-me"));
    row.classList.add("is-me");
    row.scrollIntoView({ block: "center" });
  });
  load();
  const waitParams = new URLSearchParams(location.search);
  if (waitParams.get("sync") === "wait") {
    note.textContent = "Обновляем статистику. Не закрывай вкладку.";
    const job = waitParams.get("job") || "";
    (async () => {
      for (let i = 0; i < 45; i++) {
        const data = await fetch(`/api/auth/status?job=${encodeURIComponent(job)}`).then((r) => r.json()).catch(() => null);
        if (!data || data.status === "pending") {
          await new Promise((ok) => setTimeout(ok, 2000));
          continue;
        }
        const path = data.next || "/ratings";
        const url = new URL(path, location.origin);
        if (data.status === "ok") {
          if (data.flag) url.searchParams.set("sync", data.flag);
          else url.searchParams.delete("sync");
          if (data.steamId && !url.searchParams.get("id")) url.searchParams.set("id", data.steamId);
        } else {
          url.searchParams.set("sync", data.sync || "expired");
        }
        url.searchParams.delete("job");
        location.replace(url.pathname + url.search);
        return;
      }
      location.replace("/ratings?sync=expired");
    })();
  }
</script>
