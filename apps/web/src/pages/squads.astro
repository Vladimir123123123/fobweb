---
import Base from "../layouts/Base.astro";
---
<Base title="Сквады — WARDOGS СНГ">
  <p class="eyebrow">Отряд со Steam</p>
  <h1>Сквады</h1>
  <p class="lead">Карточка сквада: логотип, описание, критерии набора, Discord и состав. Вступить может любой, кто вошёл через Steam. Один игрок состоит в одном скваде.</p>
  <form class="squad-form" id="create">
    <input id="name" placeholder="Название" maxlength="32" />
    <input id="tag" placeholder="ТЕГ" maxlength="5" />
    <textarea id="about" placeholder="Описание: чем занимается сквад" maxlength="700"></textarea>
    <textarea id="criteria" placeholder="Критерии набора: часы, роли, возраст, язык" maxlength="700"></textarea>
    <button class="btn" type="submit">Создать</button>
  </form>
  <p class="note" id="squad-note"></p>
  <div id="list" class="squad-grid"></div>
</Base>
<script>
  const list = document.querySelector("#list")!;
  const note = document.querySelector("#squad-note")!;
  const esc = (value: string) => value.replace(/[&<>"']/g, (ch) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[ch] ?? ch);

  function filePayload(file: File) {
    return new Promise<string>((resolve, reject) => {
      if (file.size > 1_200_000 || !["image/jpeg", "image/png", "image/webp"].includes(file.type)) {
        reject(new Error("image"));
        return;
      }
      const reader = new FileReader();
      reader.onload = () => resolve(String(reader.result));
      reader.onerror = () => reject(new Error("image"));
      reader.readAsDataURL(file);
    });
  }

  async function sendAsset(id: number, kind: "logo" | "banner", file: File, discord = "") {
    const image = await filePayload(file);
    const response = await fetch(`/api/squads/${id}/assets`, {
      method: "POST",
      headers: { "content-type": "application/json" },
      body: JSON.stringify({ kind, image, discord }),
    });
    if (response.status === 401) location.href = "/auth/steam?next=/squads";
    return response.ok;
  }

  async function load() {
    let response: Response;
    try {
      response = await fetch("/api/squads");
    } catch {
      note.textContent = "Список сейчас не открывается.";
      return;
    }
    if (!response.ok) {
      note.textContent = "Список сейчас не открывается.";
      return;
    }
    const data = await response.json();
    const mine = new Map((data.mine as Array<{ squad_id: number; status: string; role: string }>).map((row) => [row.squad_id, row]));
    const owned = data.desk as {
      id: number;
      name: string;
      tag: string;
      status: string;
      about: string;
      criteria: string;
      discord_url: string;
      closed: boolean;
      pending: Array<{ kind: string }>;
    } | null;
    const seated = (data.mine as Array<{ squad_id: number; status: string; role: string }>).find((row) => row.status === "member");
    if (owned || seated) document.querySelector("#create")?.setAttribute("hidden", "");
    else document.querySelector("#create")?.removeAttribute("hidden");
    const stateName = (status: string) => status === "approved" ? "Одобрено" : status === "rejected" ? "Отклонён" : "На модерации";
    const stateClass = (status: string) => status === "approved" ? "approved" : status === "rejected" ? "rejected" : "pending";
    type SquadCard = { id: number; name: string; tag: string; status: string; closed: boolean; members: number; owner_name: string | null; logo: string; about: string; criteria: string; discord_url: string };
    list.innerHTML = (data.squads as SquadCard[]).map((squad) => {
      const leader = owned?.id === squad.id;
      const waitingLogo = leader && owned.pending.some((item) => item.kind === "logo");
      const waitingBanner = leader && owned.pending.some((item) => item.kind === "banner");
      return `
      <article class="squad-tile">
        <a class="squad-square" href="/squad?id=${squad.id}">
          <span class="squad-status ${stateClass(squad.status)}">${stateName(squad.status)}</span>
          <span class="squad-mark">${squad.logo ? `<img src="${esc(squad.logo)}" alt="" />` : esc(squad.tag)}</span>
          <span class="squad-face">
            <strong>[${esc(squad.tag)}] ${esc(squad.name)}</strong>
            <p>${squad.members} в составе · ${esc(squad.owner_name ?? "владелец")}${squad.closed ? " · набор закрыт" : ""}</p>
          </span>
        </a>
        <div class="squad-actions">
          ${squad.discord_url ? `<a class="btn ghost small" href="${esc(squad.discord_url)}">Discord</a>` : ""}
          ${leader ? `<button class="btn small" data-edit type="button">Редактировать</button>` : mine.get(squad.id)?.status === "member" ? `<span class="note">Вы в составе</span>` : seated || squad.closed ? "" : `<button class="btn small" data-join="${squad.id}" type="button">Вступить</button>`}
        </div>
        ${leader ? `
          <form id="profile-form" class="squad-form squad-edit" hidden>
            <input id="profile-name" maxlength="32" value="${esc(owned.name)}" />
            <input id="profile-tag" maxlength="5" value="${esc(owned.tag)}" />
            <label>Описание<textarea id="profile-about" maxlength="700">${esc(owned.about ?? "")}</textarea></label>
            <label>Критерии набора<textarea id="profile-criteria" maxlength="700">${esc(owned.criteria ?? "")}</textarea></label>
            <label>Discord<input id="profile-discord" placeholder="https://discord.gg/..." value="${esc(owned.discord_url)}" /></label>
            <label class="check"><input id="profile-closed" type="checkbox" ${owned.closed ? "checked" : ""}/> Набор закрыт</label>
            <button class="btn small" type="submit">Сохранить карточку</button>
            <p class="note">${waitingLogo ? "Новый логотип на модерации. " : ""}${waitingBanner ? "Новый баннер на модерации." : ""}</p>
            <label>Логотип<input id="logo-file" type="file" accept="image/jpeg,image/png,image/webp" /></label>
            <button class="btn ghost small" id="logo-send" type="button">Отправить логотип</button>
            <label>Баннер<input id="banner-file" type="file" accept="image/jpeg,image/png,image/webp" /></label>
            <button class="btn ghost small" id="banner-send" type="button">Отправить баннер</button>
          </form>` : ""}
      </article>`;
    }).join("") || "<p>Сквадов пока нет.</p>";
    list.querySelector<HTMLButtonElement>("[data-edit]")?.addEventListener("click", () => {
      list.querySelector("#profile-form")?.toggleAttribute("hidden");
    });
    list.querySelector("#profile-form")?.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (!owned) return;
      const response = await fetch(`/api/squads/${owned.id}/profile`, {
        method: "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify({
          name: (document.querySelector("#profile-name") as HTMLInputElement).value,
          tag: (document.querySelector("#profile-tag") as HTMLInputElement).value,
          about: (document.querySelector("#profile-about") as HTMLTextAreaElement).value,
          criteria: (document.querySelector("#profile-criteria") as HTMLTextAreaElement).value,
          discord: (document.querySelector("#profile-discord") as HTMLInputElement).value,
          closed: (document.querySelector("#profile-closed") as HTMLInputElement).checked,
        }),
      });
      note.textContent = response.ok ? "Карточка сохранена." : "Название, тег из 2–5 букв, описание от 20 символов, критерии от 10.";
      if (response.ok) load();
    });
    list.querySelector("#logo-send")?.addEventListener("click", async () => {
      if (!owned) return;
      const file = (document.querySelector("#logo-file") as HTMLInputElement).files?.[0];
      if (!file) return;
      try {
        note.textContent = await sendAsset(owned.id, "logo", file) ? "Логотип отправлен на модерацию." : "Нужна картинка JPEG, PNG или WebP до 1,2 МБ.";
        if (note.textContent.startsWith("Логотип")) load();
      } catch {
        note.textContent = "Нужна картинка JPEG, PNG или WebP до 1,2 МБ.";
      }
    });
    list.querySelector("#banner-send")?.addEventListener("click", async () => {
      if (!owned) return;
      const file = (document.querySelector("#banner-file") as HTMLInputElement).files?.[0];
      const discord = (document.querySelector("#profile-discord") as HTMLInputElement).value;
      if (!file) return;
      try {
        note.textContent = await sendAsset(owned.id, "banner", file, discord) ? "Баннер отправлен на модерацию." : "Нужны картинка до 1,2 МБ и ссылка discord.gg.";
        if (note.textContent.startsWith("Баннер")) load();
      } catch {
        note.textContent = "Нужна картинка JPEG, PNG или WebP до 1,2 МБ.";
      }
    });
    list.querySelectorAll<HTMLButtonElement>("[data-join]").forEach((button) => {
      button.addEventListener("click", async () => {
        const response = await fetch(`/api/squads/${button.dataset.join}/join`, { method: "POST" });
        const body = await response.json().catch(() => ({}));
        if (response.status === 401) location.href = "/auth/steam?next=/squads";
        note.textContent = response.ok
          ? "Вы в составе сквада."
          : body.error === "closed"
            ? "Набор закрыт."
            : body.error === "already"
              ? "Вы уже состоите в скваде."
              : "Сейчас вступить не получилось.";
        if (response.ok) load();
      });
    });
  }
  document.querySelector("#create")?.addEventListener("submit", async (event) => {
    event.preventDefault();
    const response = await fetch("/api/squads", {
      method: "POST",
      headers: { "content-type": "application/json" },
      body: JSON.stringify({
        name: (document.querySelector("#name") as HTMLInputElement).value,
        tag: (document.querySelector("#tag") as HTMLInputElement).value,
        about: (document.querySelector("#create #about") as HTMLTextAreaElement).value,
        criteria: (document.querySelector("#create #criteria") as HTMLTextAreaElement).value,
      }),
    });
    if (response.status === 401) location.href = "/auth/steam?next=/squads";
    const created = await response.json().catch(() => ({}));
    note.textContent = response.ok
      ? "Сквад отправлен на проверку."
      : created.error === "already"
        ? "Вы уже состоите в скваде."
        : "Название, тег из 2–5 букв, описание от 20 символов и критерии от 10.";
    if (response.ok) load();
  });
  load();
</script>
