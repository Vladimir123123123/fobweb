---
import Base from "../layouts/Base.astro";
---
<Base title="Сквады — WARDOGS СНГ">
  <p class="eyebrow">Отряд со Steam</p>
  <h1>Сквады</h1>
  <p class="lead">Карточка сквада: логотип, описание, критерии набора, Discord и состав. Один игрок состоит в одном скваде.</p>
  <div id="desk"></div>
  <form class="squad-form" id="create">
    <input id="name" placeholder="Название" maxlength="32" />
    <input id="tag" placeholder="ТЕГ" maxlength="5" />
    <textarea id="about" placeholder="Описание: чем занимается сквад" maxlength="700"></textarea>
    <textarea id="criteria" placeholder="Критерии набора: часы, роли, возраст, язык" maxlength="700"></textarea>
    <button class="btn" type="submit">Создать</button>
  </form>
  <p class="note" id="squad-note"></p>
  <div id="list"></div>
</Base>
<script>
  const list = document.querySelector("#list")!;
  const desk = document.querySelector("#desk")!;
  const note = document.querySelector("#squad-note")!;
  const esc = (value: string) => value.replace(/[&<>"']/g, (ch) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[ch] ?? ch);

  function filePayload(file: File) {
    return new Promise<string>((resolve, reject) => {
      if (file.size > 1_200_000 || !["image/jpeg", "image/png", "image/webp"].includes(file.type)) {
        reject(new Error("image"));
        return;
      }
      const reader = new FileReader();
      reader.onload = () => resolve(String(reader.result));
      reader.onerror = () => reject(new Error("image"));
      reader.readAsDataURL(file);
    });
  }

  async function sendAsset(id: number, kind: "logo" | "banner", file: File, discord = "") {
    const image = await filePayload(file);
    const response = await fetch(`/api/squads/${id}/assets`, {
      method: "POST",
      headers: { "content-type": "application/json" },
      body: JSON.stringify({ kind, image, discord }),
    });
    if (response.status === 401) location.href = "/auth/steam?next=/squads";
    return response.ok;
  }

  async function load() {
    let response: Response;
    try {
      response = await fetch("/api/squads");
    } catch {
      note.textContent = "Список сейчас не открывается.";
      return;
    }
    if (!response.ok) {
      note.textContent = "Список сейчас не открывается.";
      return;
    }
    const data = await response.json();
    const mine = new Map((data.mine as Array<{ squad_id: number; status: string }>).map((row) => [row.squad_id, row.status]));
    const owned = data.desk as {
      id: number;
      name: string;
      tag: string;
      status: string;
      about: string;
      criteria: string;
      discord_url: string;
      banner_path: string | null;
      pending: Array<{ kind: string }>;
    } | null;
    if (owned) {
      const waitingLogo = owned.pending.some((item) => item.kind === "logo");
      const waitingBanner = owned.pending.some((item) => item.kind === "banner");
      const state = owned.status === "approved" ? "Сквад в списке." : owned.status === "rejected" ? "Сквад отклонён." : "Сквад ждёт проверки.";
      desk.innerHTML = `
        <article class="panel">
          <strong>[${esc(owned.tag)}] ${esc(owned.name)}</strong>
          <p>${state} ${owned.banner_path ? "Баннер уже на главной." : "Баннера на главной ещё нет."} ${waitingLogo ? "Новый логотип ждёт проверки." : ""} ${waitingBanner ? "Новый баннер ждёт проверки, на главной остаётся прежний." : ""}</p>
          <form id="profile-form" class="squad-form">
            <label>Описание<textarea id="profile-about" maxlength="700">${esc(owned.about ?? "")}</textarea></label>
            <label>Критерии набора<textarea id="profile-criteria" maxlength="700">${esc(owned.criteria ?? "")}</textarea></label>
            <label>Discord<input id="profile-discord" placeholder="https://discord.gg/..." value="${esc(owned.discord_url)}" /></label>
            <button class="btn small" type="submit">Сохранить карточку</button>
          </form>
          <form id="logo-form" class="inline">
            <input id="logo-file" type="file" accept="image/jpeg,image/png,image/webp" />
            <button class="btn small" type="submit">Отправить логотип</button>
          </form>
          <form id="banner-form" class="inline">
            <input id="banner-file" type="file" accept="image/jpeg,image/png,image/webp" />
            <input id="banner-discord" placeholder="https://discord.gg/..." value="${esc(owned.discord_url)}" />
            <button class="btn small" type="submit">Отправить баннер</button>
          </form>
        </article>
      `;
      document.querySelector("#create")?.setAttribute("hidden", "");
      desk.querySelector("#profile-form")?.addEventListener("submit", async (event) => {
        event.preventDefault();
        const response = await fetch(`/api/squads/${owned.id}/profile`, {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: JSON.stringify({
            about: (document.querySelector("#profile-about") as HTMLTextAreaElement).value,
            criteria: (document.querySelector("#profile-criteria") as HTMLTextAreaElement).value,
            discord: (document.querySelector("#profile-discord") as HTMLInputElement).value,
          }),
        });
        note.textContent = response.ok ? "Карточка сохранена." : "Описание от 20 символов, критерии от 10, Discord — ссылка discord.gg.";
        if (response.ok) load();
      });
      desk.querySelector("#logo-form")?.addEventListener("submit", async (event) => {
        event.preventDefault();
        const file = (document.querySelector("#logo-file") as HTMLInputElement).files?.[0];
        if (!file) return;
        try {
          note.textContent = await sendAsset(owned.id, "logo", file) ? "Логотип отправлен на проверку." : "Нужна картинка JPEG, PNG или WebP до 1,2 МБ.";
          if (note.textContent.startsWith("Логотип")) load();
        } catch {
          note.textContent = "Нужна картинка JPEG, PNG или WebP до 1,2 МБ.";
        }
      });
      desk.querySelector("#banner-form")?.addEventListener("submit", async (event) => {
        event.preventDefault();
        const file = (document.querySelector("#banner-file") as HTMLInputElement).files?.[0];
        const discord = (document.querySelector("#banner-discord") as HTMLInputElement).value;
        if (!file) return;
        try {
          note.textContent = await sendAsset(owned.id, "banner", file, discord) ? "Баннер отправлен на проверку." : "Нужны картинка до 1,2 МБ и ссылка discord.gg.";
          if (note.textContent.startsWith("Баннер")) load();
        } catch {
          note.textContent = "Нужна картинка JPEG, PNG или WebP до 1,2 МБ.";
        }
      });
    } else {
      desk.innerHTML = "";
      document.querySelector("#create")?.removeAttribute("hidden");
    }
    list.innerHTML = data.squads.map((squad: { id: number; name: string; tag: string; closed: boolean; members: number; owner_name: string | null; logo: string; about: string; criteria: string; discord_url: string }) => `
      <article class="panel squad-card">
        <a class="squad-mark" href="/squad?id=${squad.id}">${squad.logo ? `<img src="${esc(squad.logo)}" alt="" />` : esc(squad.tag)}</a>
        <div>
          <h2><a href="/squad?id=${squad.id}">[${esc(squad.tag)}] ${esc(squad.name)}</a></h2>
          <p>${squad.members} в составе · ${esc(squad.owner_name ?? "владелец")}${squad.closed ? " · набор закрыт" : ""}</p>
          <span class="squad-label">Описание</span>
          <p class="squad-copy">${esc(squad.about || "Сквад ещё не заполнил описание.")}</p>
          <span class="squad-label">Критерии набора</span>
          <p class="squad-copy">${esc(squad.criteria || "Критерии не указаны.")}</p>
          <div class="squad-actions">
            ${squad.discord_url ? `<a class="btn ghost small" href="${esc(squad.discord_url)}">Discord</a>` : ""}
            <a class="btn ghost small" href="/squad?id=${squad.id}">Состав</a>
            ${squad.closed ? "" : `<button class="btn small" data-join="${squad.id}" type="button">${mine.get(squad.id) === "pending" ? "Заявка отправлена" : "Подать заявку"}</button>`}
          </div>
        </div>
      </article>
    `).join("") || "<p>Сквадов пока нет.</p>";
    list.querySelectorAll<HTMLButtonElement>("[data-join]").forEach((button) => {
      button.addEventListener("click", async () => {
        const response = await fetch(`/api/squads/${button.dataset.join}/join`, { method: "POST" });
        note.textContent = response.ok ? "Заявка отправлена." : "Нужен вход через Steam, и вы ещё не состоите в другом скваде.";
        if (response.status === 401) location.href = "/auth/steam?next=/squads";
      });
    });
  }
  document.querySelector("#create")?.addEventListener("submit", async (event) => {
    event.preventDefault();
    const response = await fetch("/api/squads", {
      method: "POST",
      headers: { "content-type": "application/json" },
      body: JSON.stringify({
        name: (document.querySelector("#name") as HTMLInputElement).value,
        tag: (document.querySelector("#tag") as HTMLInputElement).value,
        about: (document.querySelector("#create #about") as HTMLTextAreaElement).value,
        criteria: (document.querySelector("#create #criteria") as HTMLTextAreaElement).value,
      }),
    });
    if (response.status === 401) location.href = "/auth/steam?next=/squads";
    note.textContent = response.ok ? "Сквад отправлен на проверку." : "Название, тег из 2–5 букв, описание от 20 символов и критерии от 10.";
    if (response.ok) load();
  });
  load();
</script>
