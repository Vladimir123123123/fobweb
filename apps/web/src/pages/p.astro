---
import Base from "../layouts/Base.astro";
---
<Base title="Профиль — WARDOGS СНГ">
  <div id="profile"><p>Загрузка профиля.</p></div>
</Base>
<script>
  const root = document.querySelector("#profile")!;
  const params = new URLSearchParams(location.search);
  const id = params.get("id") ?? "";
  const sync = params.get("sync") ?? "";
  function money(value: number | null) {
    return value === null || value === undefined ? "—" : `$${new Intl.NumberFormat("ru-RU").format(value)}`;
  }
  function chart(points: Array<{ wardog_level: number | null }>) {
    const values = points.map((point) => point.wardog_level ?? 0);
    if (values.length < 2) return "";
    const max = Math.max(...values, 1);
    const step = 280 / (values.length - 1);
    const d = values.map((value, index) => `${index === 0 ? "M" : "L"}${index * step},${80 - (value / max) * 70}`).join(" ");
    return `<svg class="chart" viewBox="0 0 280 90"><path d="${d}" fill="none" stroke="#e6b34d" stroke-width="2"/></svg>`;
  }
  if (!/^\d{17}$/.test(id)) {
    // После OAuth иногда попадаем на /p/ без id — открываем свой профиль.
    try {
      const me = await fetch("/api/me").then((r) => r.json());
      const mine = me?.user?.steam_id;
      if (/^\d{17}$/.test(mine || "")) {
        const q = sync ? `&sync=${encodeURIComponent(sync)}` : "";
        location.replace(`/p/?id=${mine}${q}`);
      } else {
        root.innerHTML = `<h1>Такой страницы нет</h1><p><a class="btn" href="/auth/wardogs/start?next=/ratings">Войти + карьера</a></p>`;
      }
    } catch {
      root.innerHTML = "<h1>Такой страницы нет</h1>";
    }
  } else {
    const [profile, me] = await Promise.all([
      fetch(`/api/players/${id}`).then(async (response) => response.ok ? response.json() : null),
      fetch("/api/me").then((response) => response.json()).catch(() => ({ user: null })),
    ]);
    if (!profile) {
      root.innerHTML = "<h1>Профиль ещё не создан</h1><p>Игрок не входил через Steam на этом сайте.</p>";
    } else {
      const user = profile.user;
      const latest = profile.history.at(-1);
      const mine = me.user?.steam_id === id;
      const empty = !profile.history.length;
      const num = (value: number | null | undefined) => value === null || value === undefined ? "—" : new Intl.NumberFormat("ru-RU").format(value);
      const syncNote = sync === "game_running"
        ? "WARDOGS была открыта — Tracker не отдал цифры. Полностью закрой игру и снова нажми «Подтянуть карьеру»."
        : sync === "token_timeout" || sync === "token_err"
          ? "Tracker долго отдавал ответ при входе. Полностью закрой WARDOGS и снова нажми «Подтянуть карьеру»."
          : sync.startsWith("token_")
            ? "Вход в Tracker не завершился. Закрой игру и нажми «Подтянуть карьеру» ещё раз."
            : sync === "empty" || empty
              ? "Цифр ещё нет. Закрой WARDOGS → «Подтянуть карьеру» → Steam. Обычный вход через Steam цифры не даёт."
              : sync === "access_denied"
                ? "Вход отменён."
                : sync === "expired"
                  ? "Сессия входа истекла. Нажми «Подтянуть карьеру» снова."
                  : sync
                    ? `Не вышло (${sync}). Закрой игру и повтори «Подтянуть карьеру».`
                    : "";
      root.innerHTML = `
        <div class="who"><img alt="" src="${user.avatar ?? ""}" /><h1>${user.persona ?? user.steam_id}</h1></div>
        <p>Steam ${user.steam_id}${user.country ? ` · ${user.country}` : ""}${user.discord_name ? ` · Discord ${user.discord_name}` : ""}</p>
        ${syncNote ? `<p class="note" id="sync-note">${syncNote}</p>` : `<p class="note" id="sync-note"></p>`}
        <div class="stats">
          <div class="stat"><b>${latest?.wardog_level ?? "—"}</b><span><img class="stat-ico" src="/art/t_ui_icon_careerlevel_600.webp" alt="" />Уровень</span></div>
          <div class="stat"><b>${num(latest?.xp)}</b><span>Опыт</span></div>
          <div class="stat"><b>${money(latest?.cash ?? null)}</b><span>Деньги</span></div>
          <div class="stat"><b>${latest?.gold ?? "—"}</b><span><img class="stat-ico" src="/art/t_ui_goldbars_icon.webp" alt="" />Золото</span></div>
          <div class="stat"><b>${latest?.unlocks ?? "—"}</b><span>Открытия</span></div>
          <div class="stat"><b>${money(latest?.account_value ?? null)}</b><span>Стоимость</span></div>
          <div class="stat"><b>${latest?.role_assault ?? "—"}</b><span><img class="stat-ico" src="/art/t_ui_icon_role_infantry.webp" alt="" />Штурм</span></div>
          <div class="stat"><b>${latest?.role_medic ?? "—"}</b><span><img class="stat-ico" src="/art/t_ui_icon_role_medic.webp" alt="" />Медик</span></div>
          <div class="stat"><b>${latest?.role_recon ?? "—"}</b><span><img class="stat-ico" src="/art/t_ui_icon_role_recon.webp" alt="" />Разведка</span></div>
          <div class="stat"><b>${latest?.role_support ?? "—"}</b><span><img class="stat-ico" src="/art/t_ui_icon_role_support.webp" alt="" />Поддержка</span></div>
          <div class="stat"><b>${latest?.role_driver ?? "—"}</b><span><img class="stat-ico" src="/art/t_ui_icon_role_driver.webp" alt="" />Водитель</span></div>
          <div class="stat"><b>${latest?.role_pilot ?? "—"}</b><span><img class="stat-ico" src="/art/t_ui_icon_role_pilot.webp" alt="" />Пилот</span></div>
        </div>
        ${chart(profile.history)}
        <p class="note">Снимков: ${profile.history.length}.</p>
        <p>${profile.squad ? `Сквад [${profile.squad.tag}] ${profile.squad.name}` : "Сквада нет."}</p>
        ${mine ? `<div class="row">
          ${empty
            ? `<a class="btn small" href="/auth/wardogs/start?next=/p&steamId=${id}">Подтянуть карьеру</a>`
            : `<button class="btn small" id="resync" type="button">Обновить цифры</button>`}
          <label><input id="show-top" type="checkbox" ${user.cis_opt_in && !user.hide_leaderboard ? "checked" : ""}/> Показывать в топе</label>
          ${me.discordLink ? `<a class="btn ghost" href="/auth/discord">Привязать Discord</a>` : ""}
        </div>
        <p class="note">Цифры даёт WARDOGS Tracker: закрой игру → «Подтянуть карьеру» → Steam. Обычный «Войти через Steam» цифры не приносит.</p>` : ""}
      `;
      const save = async () => {
        const show = (document.querySelector("#show-top") as HTMLInputElement).checked;
        await fetch("/api/me", {
          method: "PATCH",
          headers: { "content-type": "application/json" },
          body: JSON.stringify({ showInTop: show }),
        });
      };
      document.querySelector("#show-top")?.addEventListener("change", save);
      document.querySelector("#resync")?.addEventListener("click", async () => {
        const note = document.querySelector("#sync-note")!;
        const next = `/p?id=${id}`;
        note.textContent = "Обновляю…";
        const response = await fetch("/api/me/sync", { method: "POST" });
        if (response.status === 401) {
          location.href = `/auth/steam?next=${encodeURIComponent(next)}`;
          return;
        }
        const body = await response.json().catch(() => ({}));
        if (body.saved) {
          location.href = next;
          return;
        }
        location.href = `/auth/wardogs/start?next=/p&steamId=${id}`;
      });
    }
  }
</script>
