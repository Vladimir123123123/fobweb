---
import Base from "../layouts/Base.astro";
import catalog from "../data/catalog.json";

const gunIcons: Record<string, string> = {};
for (const gun of [...catalog.weapons, ...catalog.sidearms]) {
  if (gun.name && gun.icon && /^[a-z0-9_]+\.webp$/.test(gun.icon)) gunIcons[gun.name.toLowerCase()] = gun.icon;
}
---
<Base title="Профиль — WARDOGS СНГ">
  <div id="profile" data-guns={JSON.stringify(gunIcons)}><p>Загрузка профиля.</p></div>
</Base>
<script>
  const root = document.querySelector("#profile")!;
  const gunIcons = JSON.parse(root.getAttribute("data-guns") || "{}") as Record<string, string>;
  const params = new URLSearchParams(location.search);
  const id = params.get("id") ?? "";
  const sync = params.get("sync") ?? "";
  const job = params.get("job") ?? "";
  const reward = params.get("reward") ?? "";

  const esc = (value: unknown) => String(value ?? "").replace(/[&<>"']/g, (ch) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[ch] ?? ch);
  function money(value: number | null | undefined) {
    return value === null || value === undefined ? "—" : `$${new Intl.NumberFormat("ru-RU").format(value)}`;
  }
  const num = (value: number | null | undefined) => value === null || value === undefined ? "—" : new Intl.NumberFormat("ru-RU").format(value);
  function kdText(value: unknown) {
    if (value === null || value === undefined || value === "") return "—";
    const parsed = Number(value);
    return Number.isFinite(parsed) ? parsed.toLocaleString("ru-RU", { minimumFractionDigits: 2, maximumFractionDigits: 2 }) : "—";
  }
  function stamp(value: unknown) {
    const date = new Date(String(value ?? ""));
    if (Number.isNaN(date.getTime())) return "";
    return new Intl.DateTimeFormat("ru-RU", { day: "2-digit", month: "2-digit", year: "numeric", hour: "2-digit", minute: "2-digit" }).format(date);
  }
  function when(value: unknown) {
    const date = new Date(String(value ?? ""));
    if (Number.isNaN(date.getTime())) return "";
    return new Intl.DateTimeFormat("ru-RU", { day: "numeric", month: "short", year: "numeric" }).format(date);
  }
  function shift(now: number | null | undefined, prev: number | null | undefined) {
    if (now == null || prev == null) return "";
    const diff = Number(now) - Number(prev);
    if (!diff) return "";
    const sign = diff > 0 ? "+" : "−";
    return `<em class="${diff > 0 ? "up" : "down"}">${sign}${new Intl.NumberFormat("ru-RU").format(Math.abs(diff))}</em>`;
  }
  function chart(points: Array<{ wardog_level: number | null; created_at?: string }>, stroke = "#e4b04a") {
    const values = points.map((point) => point.wardog_level ?? 0);
    if (values.length < 2) return `<p class="note">Один снимок. Линия появится после следующего обновления.</p>`;
    const max = Math.max(...values, 1);
    const min = Math.min(...values);
    const span = Math.max(max - min, 1);
    const width = 640;
    const height = 180;
    const step = width / (values.length - 1);
    const y = (value: number) => 18 + (1 - (value - min) / span) * (height - 44);
    const dots = values.map((value, index) => [index * step, y(value)] as const);
    // Плавная кривая: касательные по соседним точкам (Catmull-Rom → Bezier)
    let line = `M${dots[0][0]},${dots[0][1]}`;
    for (let i = 0; i < dots.length - 1; i++) {
      const p0 = dots[i - 1] ?? dots[i];
      const p1 = dots[i];
      const p2 = dots[i + 1];
      const p3 = dots[i + 2] ?? p2;
      const c1x = p1[0] + (p2[0] - p0[0]) / 6;
      const c2x = p2[0] - (p3[0] - p1[0]) / 6;
      const c1y = Math.min(Math.max(p1[1] + (p2[1] - p0[1]) / 6, 0), height);
      const c2y = Math.min(Math.max(p2[1] - (p3[1] - p1[1]) / 6, 0), height);
      line += ` C${c1x.toFixed(1)},${c1y.toFixed(1)} ${c2x.toFixed(1)},${c2y.toFixed(1)} ${p2[0].toFixed(1)},${p2[1].toFixed(1)}`;
    }
    const area = `${line} L${width},${height} L0,${height} Z`;
    const last = values.at(-1) ?? 0;
    const gid = `lvl${Math.random().toString(36).slice(2, 7)}`;
    const grid = [0.25, 0.5, 0.75].map((f) => `<line class="grid-line" x1="0" x2="${width}" y1="${(height * f).toFixed(0)}" y2="${(height * f).toFixed(0)}"></line>`).join("");
    return `<svg class="dossier-chart" viewBox="0 0 ${width} ${height}" preserveAspectRatio="none" role="img" aria-label="Уровень по снимкам">
      <defs>
        <linearGradient id="${gid}" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#ffb703" stop-opacity="0.55"/><stop offset="1" stop-color="#ffb703" stop-opacity="0"/></linearGradient>
        <filter id="${gid}g" x="-5%" y="-30%" width="110%" height="160%"><feGaussianBlur stdDeviation="4" result="b"/><feMerge><feMergeNode in="b"/><feMergeNode in="SourceGraphic"/></feMerge></filter>
      </defs>
      ${grid}
      <path d="${area}" fill="url(#${gid})"></path>
      <path d="${line}" fill="none" stroke="#ffb703" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" vector-effect="non-scaling-stroke" filter="url(#${gid}g)"></path>
    </svg>
    <p class="dossier-axis"><span>${esc(when(points[0]?.created_at))}</span><span>${esc(when(points.at(-1)?.created_at))} · ${num(last)} ур.</span></p>`;
  }

  async function waitJob() {
    root.innerHTML = "<p>Steam забирает карьеру из игры. WARDOGS должен быть закрыт. Не закрывай вкладку.</p>";
    for (let i = 0; i < 45; i++) {
      const data = await fetch(`/api/auth/status?job=${encodeURIComponent(job)}`).then((r) => r.json()).catch(() => null);
      if (!data || data.status === "pending") {
        await new Promise((ok) => setTimeout(ok, 2000));
        continue;
      }
      const path = data.next || (id ? `/p/?id=${id}` : "/ratings");
      const url = new URL(path, location.origin);
      if (data.status === "ok") {
        if (data.flag) url.searchParams.set("sync", data.flag);
        else url.searchParams.delete("sync");
        if (data.coins > 0) url.searchParams.set("reward", String(data.coins));
        else if (data.already) url.searchParams.set("reward", "done");
        if (!url.searchParams.get("id") && data.steamId) url.searchParams.set("id", data.steamId);
      } else {
        url.searchParams.set("sync", data.sync || "expired");
      }
      url.searchParams.delete("job");
      location.replace(url.pathname + url.search);
      return;
    }
    location.replace(id ? `/p/?id=${id}&sync=token_timeout` : "/ratings?sync=token_timeout");
  }

  if (sync === "wait") {
    await waitJob();
  } else if (!/^\d{17}$/.test(id)) {
    try {
      const me = await fetch("/api/me").then((r) => r.json());
      const mine = me?.user?.steam_id;
      if (/^\d{17}$/.test(mine || "")) {
        location.replace(`/p/?id=${mine}`);
      } else {
        root.innerHTML = `<h1>Такой страницы нет</h1><p><a class="btn" href="/auth/steam?next=/ratings">Войти через Steam</a></p>`;
      }
    } catch {
      root.innerHTML = "<h1>Такой страницы нет</h1>";
    }
  } else {
    const [profile, me, board] = await Promise.all([
      fetch(`/api/players/${id}`).then(async (response) => response.ok ? response.json() : null),
      fetch("/api/me").then((response) => response.json()).catch(() => ({ user: null })),
      fetch("/api/ratings?sort=level").then(async (response) => response.ok ? response.json() : null).catch(() => null),
    ]);
    if (!profile) {
      root.innerHTML = "<h1>Профиль ещё не создан</h1><p>Игрок не входил через Steam на этом сайте.</p>";
    } else {
      const user = profile.user;
      const history = profile.history as Array<Record<string, number | string | null>>;
      const latest = history.at(-1);
      const previous = history.length > 1 ? history.at(-2) : undefined;
      const mine = me.user?.steam_id === id;
      const empty = !history.length;
      const roles = [
        ["role_assault", "Штурм", "/art/t_ui_icon_role_infantry.webp"],
        ["role_medic", "Медик", "/art/t_ui_icon_role_medic.webp"],
        ["role_recon", "Разведка", "/art/t_ui_icon_role_recon.webp"],
        ["role_support", "Поддержка", "/art/t_ui_icon_role_support.webp"],
        ["role_driver", "Водитель", "/art/t_ui_icon_role_driver.webp"],
        ["role_pilot", "Пилот", "/art/t_ui_icon_role_pilot.webp"],
      ] as const;
      const levels = roles.map(([key, name, icon]) => ({ key, name, icon, level: Number(latest?.[key] ?? 0) || 0 }));
      const peak = Math.max(...levels.map((role) => role.level), 1);
      const primary = levels.reduce((best, role) => role.level > best.level ? role : best, levels[0]);
      const listed = (board?.players ?? []) as Array<{ steam_id?: string }>;
      const placeIndex = listed.findIndex((row) => String(row.steam_id) === id);
      const hidden = Boolean(user.hide_leaderboard) || !user.cis_opt_in;
      const place = placeIndex >= 0 ? `место #${placeIndex + 1}` : hidden ? "скрыт из топа" : "вне топ-200";
      const squad = profile.squad as { id: number; name: string; tag: string; role?: string; logo?: string } | null;
      const picture = (value: unknown) => /^\/api\/media\/[a-f0-9]{32}\.(jpg|png|webp)$/.test(String(value ?? "")) ? String(value) : "";
      const logo = picture(squad?.logo);
      const accents = ["orange", "gold", "blue", "red", "green"] as const;
      const accent = accents.find((name) => name === user.accent) ?? "";
      const marks: Record<string, string> = { orange: "#ff4d1c", gold: "#e4b04a", blue: "#6ea2ff", red: "#ff5a4a", green: "#3dba7a" };
      const motto = String(user.motto ?? "").trim();
      const combat = profile.combat as {
        kills?: number | null; deaths?: number | null; kd?: number | string | null; place?: number | null; of?: number | null;
        headshots?: number | null; headshotPct?: number | null; longest?: number | null; average?: number | null;
        bestMatch?: number | null; matches?: number | null; perMatch?: number | null; faction?: string | null; side?: string | null;
        teamkills?: number | null; enemy?: { name?: string; count?: number } | null; target?: { name?: string; count?: number } | null;
        weapons?: Array<{ name?: string; kills?: number; headshots?: number }>; winrate?: number | null;
        history?: Array<{ endedAt?: string | null; server?: string; map?: string; minutes?: number | null; faction?: string; result?: string; place?: number | null; field?: number | null; kills?: number; deaths?: number; kd?: number | null; headshots?: number; teamkills?: number; weapon?: string }>;
        since?: string | null; last?: string | null;
      } | null;
      const resultLabel = (result: string | undefined) => result === "win" ? "Выиграно" : result === "loss" ? "Потеряно" : result === "leave" ? "Досрочный выход" : "—";
      const resultClass = (result: string | undefined) => result === "win" ? "win" : result === "loss" ? "loss" : "";
      const matches = (combat?.history ?? []).filter((item) => String(item.map || "").trim() || String(item.result || "").trim());
      const matchTotal = matches.length < 40 ? matches.length : (combat?.matches ?? matches.length);
      const punishments = (profile.punishments ?? []) as Array<{ kind?: string; reason?: string; startedAt?: string | null; untilAt?: string | null; active?: boolean; liftedAt?: string | null }>;
      const term = (item: { untilAt?: string | null; active?: boolean; liftedAt?: string | null }) => item.untilAt ? `до ${stamp(item.untilAt)}` : item.active ? "до снятия" : item.liftedAt ? `снято ${stamp(item.liftedAt)}` : "—";
      const portraits: Record<string, string> = {
        lone: "/brand/operators/lone.webp",
        valk: "/brand/operators/valk.webp",
        mant: "/brand/operators/mant.webp",
      };
      const portrait = portraits[String(combat?.side || "")] ?? "";
      const factionTone = (name: string) => {
        const key = name.toLowerCase();
        if (key.includes("valk")) return "valk";
        if (key.includes("mant")) return "mant";
        if (key.includes("lone")) return "lone";
        return "";
      };
      const sideMark = (name: string) => {
        const key = name.toLowerCase();
        if (key.includes("valk")) return "/brand/factions/vk.png";
        if (key.includes("mant")) return "/brand/factions/mc.png";
        if (key.includes("lone") || key.includes("star")) return "/brand/factions/ls.png";
        return "";
      };
      const sideLabel = (name: string) => {
        const label = name.trim();
        const key = label.toLowerCase();
        if (!label || key === "white" || key === "unknown") return "";
        return label;
      };
      const mapCard = (name: string) => {
        const key = name.toLowerCase();
        if (key.includes("ozet") || key.includes("madrid") || key.includes("europe")) return { file: "ozeti", title: "Ozeti" };
        if (key.includes("sabat") || key.includes("moscow") || key.includes("russia")) return { file: "sabatulo", title: "Sabatulo" };
        if (key.includes("bakur") || key.includes("kavkaz")) return { file: "bakurani", title: "Bakurani" };
        if (key.includes("zesta") || key.includes("america") || key.includes("detroit")) return { file: "zestafona", title: "Zestafona" };
        return null;
      };
      const gunIcon = (name: string) => {
        const key = name.trim().toLowerCase();
        if (!key || key === "default" || key === "неизвестно") return "";
        return (gunIcons as Record<string, string>)[key] || "";
      };
      const piece = (icon: string, label: string, kind = "") => `<span class="piece${kind ? ` ${kind}` : ""}">${icon ? `<img src="${icon}" alt="" />` : ""}<span>${esc(label)}</span></span>`;
      const meter = (value: number | null | undefined, suffix = "") => value == null ? "—" : `${num(value)}${suffix}`;
      const rival = (row: { name?: string; count?: number } | null | undefined) => row?.name ? `${esc(row.name)} · ${num(row.count)}×` : "—";
      const weapons = combat?.weapons ?? [];
      const topGun = Math.max(...weapons.map((gun) => Number(gun.kills) || 0), 1);
      const played = combat?.since || combat?.last
        ? `Играет здесь с ${esc(stamp(combat?.since) || "—")} · последний раз ${esc(stamp(combat?.last) || "—")}`
        : "";
      // Число для анимации набега: текст уже финальный, data-* читает скрипт после отрисовки
      const cnt = (value: unknown, decimals = 0, suffix = "") => {
        if (value === null || value === undefined || value === "" || !Number.isFinite(Number(value))) return "<b>—</b>";
        const n = Number(value);
        const text = n.toLocaleString("ru-RU", { minimumFractionDigits: decimals, maximumFractionDigits: decimals });
        return `<b data-count="${n}" data-dec="${decimals}" data-suffix="${esc(suffix)}">${text}${esc(suffix)}</b>`;
      };
      // Фоновые картинки плиток: иконка вместо пустоты, график — по реальным матчам игрока
      const glyphs: Record<string, string> = {
        crosshair: `<circle cx="12" cy="12" r="7"/><path d="M12 2v5M12 17v5M2 12h5M17 12h5"/>`,
        trophy: `<path d="M8 4h8v5a4 4 0 0 1-8 0V4Z"/><path d="M8 6H4v1a3 3 0 0 0 4 3M16 6h4v1a3 3 0 0 1-4 3M12 13v4M8 20h8"/>`,
        ruler: `<path d="M3 15 15 3l6 6L9 21 3 15Z"/><path d="m7 11 2 2M10 8l2 2M13 5l2 2"/>`,
        target: `<circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="5"/><circle cx="12" cy="12" r="1"/>`,
        swords: `<path d="m5 19 9-9M14 5h5v5M5 5l14 14"/>`,
        shield: `<path d="M12 3 4 6v6c0 4.500 3.400 7.700 8 9 4.600-1.300 8-4.500 8-9V6l-8-3Z"/>`,
      };
      const glyph = (name: string) => `<svg class="tile-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${glyphs[name] ?? ""}</svg>`;
      const ordered = [...matches].sort((a, b) => (Date.parse(String(a.endedAt)) || 0) - (Date.parse(String(b.endedAt)) || 0));
      const spark = (key: "kills" | "kd" | "headshots") => {
        const values = ordered.map((item) => item[key] == null ? Number.NaN : Number(item[key])).filter((value) => Number.isFinite(value)).slice(-14);
        if (values.length < 2) return "";
        const top = Math.max(...values);
        const low = Math.min(...values);
        const range = Math.max(top - low, 1e-6);
        const d = values.map((value, i) => `${i ? "L" : "M"}${(i * (100 / (values.length - 1))).toFixed(1)},${(34 - ((value - low) / range) * 28).toFixed(1)}`).join(" ");
        return `<svg class="spark" viewBox="0 0 100 36" preserveAspectRatio="none" aria-hidden="true"><path class="spark-fill" d="${d} L100,36 L0,36 Z"/><path class="spark-line" d="${d}" vector-effect="non-scaling-stroke"/></svg>`;
      };
      const heroMap = matches.map((item) => mapCard(String(item.map || ""))).find(Boolean)?.file ?? "ozeti";
      const paid = Number(reward);
      const rewardNote = paid > 0
        ? `За обновление статистики начислено ${paid} очков. Следующие — завтра.`
        : reward === "done"
          ? "Сегодняшние 10 очков за обновление статистики уже начислены."
          : "";
      const syncNote = sync === "same"
        ? "Цифры те же, что уже были. Свежее игра отдаст, если закрыть WARDOGS и снять ещё раз."
        : sync === "game_running"
          ? "Игра была запущена. Полностью закрой WARDOGS и нажми «Снять из игры»."
          : sync === "stale"
            ? "Игра не отдала свежий снимок. Записали последние известные цифры. Закрой клиент и сними ещё раз."
          : sync === "access_denied"
            ? "Steam отменён. Нажми «Снять из игры» и подтверди вход."
          : empty && !combat
            ? "Цифр ещё нет. Закрой WARDOGS и нажми «Снять из игры» — откроется Steam, мы запишем карьеру."
            : sync === "expired"
              ? "Код входа истёк. Нажми «Снять из игры» ещё раз."
              : sync && sync !== "ok"
                ? "Не вышло снять карьеру. Закрой игру и нажми ещё раз."
                : "";
      const syncText = [rewardNote, syncNote].filter(Boolean).join(" ");
      root.innerHTML = `
        <article class="dossier"${accent ? ` data-accent="${accent}"` : ""}>
          <header class="dossier-hero${portrait ? " has-op" : ""}">
            <img class="dossier-bg dossier-map" alt="" src="/brand/maps/${heroMap}.webp" />
            ${user.avatar ? `<img class="dossier-bg dossier-tint" alt="" src="${esc(user.avatar)}" />` : ""}
            <div class="dossier-id">
              <div class="dossier-face">
                <img class="dossier-avatar" alt="" src="${esc(user.avatar ?? "")}" />
                ${logo ? `<img class="dossier-clan" alt="" src="${esc(logo)}" />` : ""}
              </div>
              <div>
                <p class="eyebrow">Досье · сезон ${esc(String(board?.season || "03"))}</p>
                <h1>${esc(user.persona ?? user.steam_id)}</h1>
                ${motto ? `<p class="dossier-line">${esc(motto)}</p>` : ""}
                <div class="dossier-tags">
                  <span class="pill">${esc(place)}</span>
                  ${primary.level ? `<span class="pill now">${esc(primary.name)} ${primary.level}</span>` : ""}
                  ${squad ? `<a class="pill" href="/squad/?id=${squad.id}">[${esc(squad.tag)}] ${esc(squad.name)}</a>` : `<span class="pill old">без сквада</span>`}
                  ${user.country ? `<span class="pill">${esc(user.country)}</span>` : ""}
                  ${user.discord_name ? `<span class="pill">Discord ${esc(user.discord_name)}</span>` : ""}
                </div>
              </div>
              <div class="dossier-level">
                <img src="/art/t_ui_icon_careerlevel_600.webp" alt="" />
                <b>${latest?.wardog_level ?? "—"}</b>
                <span>уровень ${shift(latest?.wardog_level as number | null, previous?.wardog_level as number | null)}</span>
              </div>
            </div>
            ${portrait ? `<div class="dossier-op-wrap"><img class="dossier-op" alt="" src="${portrait}" /></div>` : ""}
          </header>
          ${syncText ? `<p class="note dossier-alert" id="sync-note">${esc(syncText)}</p>` : `<p class="note" id="sync-note"></p>`}
          <section class="dossier-meters">
            <div><span>Опыт ${shift(latest?.xp as number | null, previous?.xp as number | null)}</span><b>${num(latest?.xp as number | null)}</b></div>
            <div><span>Деньги ${shift(latest?.cash as number | null, previous?.cash as number | null)}</span><b>${money(latest?.cash as number | null)}</b></div>
            <div><span>Золото ${shift(latest?.gold as number | null, previous?.gold as number | null)}</span><b><img src="/art/t_ui_goldbars_icon.webp" alt="" />${latest?.gold ?? "—"}</b></div>
            <div><span>Открытия</span><b>${latest?.unlocks ?? "—"}</b></div>
            <div><span>Стоимость</span><b>${money(latest?.account_value as number | null)}</b></div>
            <div><span>Снимков</span><b>${history.length}</b></div>
          </section>
          ${combat ? `<section class="fight-card">
            <header>
              <p class="eyebrow">Статистика игрока</p>
              <p>Этот сервер, за всё время</p>
            </header>
            <div class="bento">
              <div class="tile tile-kd">
                <span>К/Д</span>
                ${cnt(combat.kd, 2)}
                <small>${num(combat.kills)} убийств · ${num(combat.deaths)} смертей</small>
                <em>Место #${num(combat.place)} из ${num(combat.of)}</em>
                ${spark("kd")}
              </div>
              <div class="tile tile-win">
                <i class="tile-ring" style="--p:${Math.max(0, Math.min(100, Number(combat.winrate) || 0))}"></i>
                <span>Винрейт</span>
                ${cnt(combat.winrate, 1, "%")}
              </div>
              <div class="tile"><span>Хедшоты</span>${cnt(combat.headshotPct, 1, "%")}<small>${combat.headshots == null ? "" : `${num(combat.headshots)} шт.`}</small>${spark("headshots") || glyph("crosshair")}</div>
              <div class="tile"><span>Лучший матч</span>${cnt(combat.bestMatch)}<small>убийств</small>${spark("kills") || glyph("trophy")}</div>
              <div class="tile"><span>Самое дальнее</span>${cnt(combat.longest, 0, " м")}${glyph("ruler")}</div>
              <div class="tile"><span>Ср. дистанция</span>${cnt(combat.average, 0, " м")}${glyph("target")}</div>
              <div class="tile"><span>Матчи</span>${matchTotal ? cnt(matchTotal) : "<b>—</b>"}<small>${matchTotal ? `по ${combat.perMatch ?? "—"} убийств` : ""}</small>${glyph("swords")}</div>
              <div class="tile"><span>Основная сторона</span><b class="${factionTone(String(combat.faction || ""))}">${esc(String(combat.faction || "").trim()) || "—"}</b>${glyph("shield")}</div>
              <div class="tile"><span>Убийства своих</span>${cnt(combat.teamkills)}${glyph("shield")}</div>
              <div class="tile tile-wide">
                <p><span>Заклятый враг</span><b>${rival(combat.enemy)}</b></p>
                <p><span>Любимая цель</span><b>${rival(combat.target)}</b></p>
              </div>
            </div>
            ${weapons.length ? `<div class="fight-card-guns">
              <p class="eyebrow">Оружие</p>
              ${weapons.map((gun, index) => {
                const name = String(gun.name || "неизвестно");
                const icon = gunIcon(name);
                const kills = Number(gun.kills) || 0;
                const precise = kills >= 10 && (Number(gun.headshots) || 0) / kills >= 0.2;
                const tag = precise ? `<svg class="gun-tag" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" role="img" aria-label="Много хедшотов"><title>Много хедшотов</title>${glyphs.crosshair}</svg>` : "";
                return `<p class="gun-bar">${icon ? `<img src="/art/${icon}" alt="" />` : `<span class="ico-gap">—</span>`}<span class="gun-body"><b>${esc(name)}${tag}</b><i><u style="--w:${Math.max(3, Math.round((kills / topGun) * 100))}%;--d:${index * 90}ms"></u></i></span><span class="gun-num"><strong>${num(gun.kills)}</strong> · ${num(gun.headshots)} HS</span></p>`;
              }).join("")}
            </div>` : `<p class="note">Оружие, хедшоты и дистанция появятся со следующими убийствами, которые пришлёт сервер.</p>`}
            ${played ? `<p class="note">${played}</p>` : ""}
          </section>
          ${matches.length ? `<section class="match-log">
            <header>
              <p class="eyebrow">Матчи</p>
              <p>Этот сервер, хранить навсегда</p>
            </header>
            <div class="match-scroll">
              <table>
                <thead>
                  <tr>${matches.some((item) => stamp(item.endedAt)) ? "<th>Завершено</th>" : ""}${matches.some((item) => String(item.server || "").trim()) ? "<th>Сервер</th>" : ""}<th>Карта</th><th>Сторона</th><th>Результат</th><th>Место</th><th>У</th><th>С</th><th>К/Д</th><th>ХШ</th><th>ТК</th><th>Оружие</th></tr>
                </thead>
                <tbody>
                  ${matches.map((item) => {
                    const known = mapCard(String(item.map || ""));
                    const mapTitle = known?.title || String(item.map || "");
                    const mapCell = mapTitle ? piece(known ? `/brand/maps/${known.file}.webp` : "", `${mapTitle}${item.minutes ? ` · ${num(item.minutes)} мин` : ""}`, "map") : "—";
                    const side = sideLabel(String(item.faction || ""));
                    const sideCell = side ? piece(sideMark(side), side) : "—";
                    const gun = String(item.weapon || "").trim();
                    const gunCell = gun && gun.toLowerCase() !== "default" ? piece(gunIcon(gun) ? `/art/${gunIcon(gun)}` : "", gun, "gun") : "—";
                    return `<tr>
                    ${stamp(item.endedAt) || matches.some((row) => stamp(row.endedAt)) ? `<td>${esc(stamp(item.endedAt) || "—")}</td>` : ""}
                    ${String(item.server || "").trim() || matches.some((row) => String(row.server || "").trim()) ? `<td>${esc(item.server || "—")}</td>` : ""}
                    <td>${mapCell}</td>
                    <td class="${factionTone(side)}">${sideCell}</td>
                    <td class="${resultClass(item.result)}">${resultLabel(item.result)}</td>
                    <td>${item.place ? `#${num(item.place)}${item.field ? ` из ${num(item.field)}` : ""}` : "—"}</td>
                    <td>${num(item.kills)}</td>
                    <td>${num(item.deaths)}</td>
                    <td>${item.kd == null ? "—" : Number(item.kd).toLocaleString("ru-RU", { minimumFractionDigits: 2, maximumFractionDigits: 2 })}</td>
                    <td>${num(item.headshots)}</td>
                    <td>${num(item.teamkills)}</td>
                    <td>${gunCell}</td>
                  </tr>`;
                  }).join("")}
                </tbody>
              </table>
            </div>
          </section>` : ""}` : ""}
          ${punishments.length ? `<section class="punishments">
            <header>
              <p class="eyebrow">Наказания</p>
              <p>Этот сервер</p>
            </header>
            <table>
              <thead><tr><th>Что</th><th>За что</th><th>Когда</th><th>Срок</th></tr></thead>
              <tbody>
                ${punishments.map((item) => `<tr>
                  <td>${item.kind === "ban" ? "Бан" : "Наказание"}</td>
                  <td>${esc(item.reason || "не указана")}</td>
                  <td>${esc(stamp(item.startedAt) || "—")}</td>
                  <td>${esc(term(item))}</td>
                </tr>`).join("")}
              </tbody>
            </table>
          </section>` : ""}
          <section class="dossier-split">
            <div class="panel">
              <p class="eyebrow">Классы</p>
              <h2>${primary.level ? esc(primary.name) : "Классов пока нет"}</h2>
              <div class="class-lanes">
                ${levels.map((role) => `
                  <div class="lane${role.name === primary.name && role.level ? " lead" : ""}">
                    <img src="${role.icon}" alt="" />
                    <span>${role.name}</span>
                    <i><b style="width:${Math.round((role.level / peak) * 100)}%"></b></i>
                    <strong>${role.level || "—"}</strong>
                  </div>`).join("")}
              </div>
            </div>
            <div class="panel">
              <p class="eyebrow">Как рос уровень</p>
              <h2>${history.length > 1 ? (shift(latest?.wardog_level as number | null, history[0]?.wardog_level as number | null) ? `${shift(latest?.wardog_level as number | null, history[0]?.wardog_level as number | null)} с первого снимка` : "Уровень держится") : "Ждём второй снимок"}</h2>
              ${chart(history as Array<{ wardog_level: number | null; created_at?: string }>, marks[accent] ?? "#e4b04a")}
              <p class="note">Последний снимок: ${esc(when(latest?.created_at) || "ещё не было")}. <a href="https://steamcommunity.com/profiles/${id}">Steam</a> · <button class="linkish" id="copy-profile" type="button">Скопировать ссылку</button></p>
            </div>
          </section>
          ${mine ? `<form class="dossier-tune" id="tune">
            <label>Строка под ником
              <input id="motto" maxlength="80" value="${esc(motto)}" placeholder="Коротко о себе, до 80 знаков" />
            </label>
            <div class="swatches" role="radiogroup" aria-label="Цвет досье">
              ${[["", "Как есть"], ["orange", "Огонь"], ["gold", "Золото"], ["blue", "Синий"], ["red", "Красный"], ["green", "Зелёный"]].map(([name, label]) => `
                <label class="swatch">
                  <input type="radio" name="accent" value="${name}" ${accent === name ? "checked" : ""} />
                  <i class="dot ${name || "plain"}"></i>
                  <span>${label}</span>
                </label>`).join("")}
            </div>
            <button class="btn small" type="submit">Сохранить вид</button>
            <p class="note" id="tune-note">Строку и цвет видят все, кто откроет это досье. Баннер сквада здесь не показывается.</p>
          </form>
          <div class="dossier-own">
            <a class="btn small" href="/auth/wardogs/start?next=/p&steamId=${esc(id)}">Снять из игры</a>
            <button class="btn ghost small" id="resync" type="button">Из открытой базы</button>
            <label class="check"><input id="show-top" type="checkbox" ${user.cis_opt_in && !user.hide_leaderboard ? "checked" : ""}/> Показывать в топе</label>
            ${me.discordLink ? `<a class="btn ghost small" href="/auth/discord">Привязать Discord</a>` : ""}
            <p class="note">Закрой WARDOGS, нажми «Снять из игры», подтверди Steam — мы только запишем цифры. Вход на сайт в шапке отдельно.</p>
          </div>` : ""}
        </article>
      `;
      // Живость: параллакс шапки и набег чисел
      const calm = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      const hero = root.querySelector<HTMLElement>(".dossier-hero");
      if (hero && !calm) {
        hero.addEventListener("pointermove", (event) => {
          const box = hero.getBoundingClientRect();
          hero.style.setProperty("--px", ((event.clientX - box.left) / box.width - 0.5).toFixed(3));
          hero.style.setProperty("--py", ((event.clientY - box.top) / box.height - 0.5).toFixed(3));
        });
        hero.addEventListener("pointerleave", () => {
          hero.style.setProperty("--px", "0");
          hero.style.setProperty("--py", "0");
        });
      }
      const runCount = (el: HTMLElement) => {
        const to = Number(el.dataset.count);
        const dec = Number(el.dataset.dec) || 0;
        const suffix = el.dataset.suffix ?? "";
        const started = performance.now();
        const step = (now: number) => {
          const t = Math.min(1, (now - started) / 1200);
          const eased = 1 - Math.pow(1 - t, 3);
          el.textContent = `${(to * eased).toLocaleString("ru-RU", { minimumFractionDigits: dec, maximumFractionDigits: dec })}${suffix}`;
          if (t < 1) requestAnimationFrame(step);
        };
        requestAnimationFrame(step);
      };
      const counters = root.querySelectorAll<HTMLElement>("[data-count]");
      if (!calm && "IntersectionObserver" in window) {
        const seen = new IntersectionObserver((entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            seen.unobserve(entry.target);
            runCount(entry.target as HTMLElement);
          }
        }, { threshold: 0.4 });
        counters.forEach((el) => seen.observe(el));
      }
      const save = async () => {
        const show = (document.querySelector("#show-top") as HTMLInputElement).checked;
        await fetch("/api/me", {
          method: "PATCH",
          headers: { "content-type": "application/json" },
          body: JSON.stringify({ showInTop: show }),
        });
      };
      document.querySelector("#show-top")?.addEventListener("change", save);
      document.querySelector("#tune")?.addEventListener("submit", async (event) => {
        event.preventDefault();
        const note = document.querySelector("#tune-note")!;
        const mottoField = document.querySelector<HTMLInputElement>("#motto");
        const picked = document.querySelector<HTMLInputElement>('input[name="accent"]:checked');
        const response = await fetch("/api/me", {
          method: "PATCH",
          headers: { "content-type": "application/json" },
          body: JSON.stringify({ motto: mottoField?.value ?? "", accent: picked?.value ?? "" }),
        });
        if (response.status === 401) {
          location.href = `/auth/steam?next=${encodeURIComponent(location.pathname + location.search)}`;
          return;
        }
        if (!response.ok) {
          note.textContent = "Не сохранилось. Выбери цвет из списка и укороти строку.";
          return;
        }
        location.reload();
      });
      document.querySelector("#resync")?.addEventListener("click", async () => {
        const note = document.querySelector("#sync-note")!;
        const button = document.querySelector<HTMLButtonElement>("#resync")!;
        button.disabled = true;
        note.classList.add("dossier-alert");
        note.textContent = "Обновляю статистику…";
        try {
          const feed = await fetch(`https://wardogstracker.gg/api/v1/players/${id}`, {
            signal: AbortSignal.timeout(8_000),
          });
          const pack = feed.ok ? await feed.json().catch(() => null) : null;
          const response = await fetch("/api/me/sync", {
            method: "POST",
            headers: { "content-type": "application/json" },
            body: JSON.stringify(pack && pack.player ? { player: pack.player } : {}),
            signal: AbortSignal.timeout(8_000),
          });
          if (response.status === 401) {
            location.href = `/auth/steam?next=${encodeURIComponent(`/p/?id=${id}`)}`;
            return;
          }
          const result = await response.json().catch(() => ({})) as { saved?: boolean; unchanged?: boolean; reason?: string; coins?: number; already?: boolean };
          if (result.saved) {
            const back = new URL(`/p/`, location.origin);
            back.searchParams.set("id", id);
            if (result.unchanged) back.searchParams.set("sync", "same");
            if (result.coins) back.searchParams.set("reward", String(result.coins));
            else if (result.already) back.searchParams.set("reward", "done");
            location.href = back.pathname + back.search;
            return;
          }
          note.textContent = result.reason === "tracker_down"
            ? "База карьеры не ответила. Нажми ещё раз."
            : "В открытой базе этого игрока ещё нет.";
        } catch {
          note.textContent = "Слишком долго. Нажми ещё раз — запрос оборвался.";
        }
        button.disabled = false;
      });
      document.querySelector("#copy-profile")?.addEventListener("click", async () => {
        const button = document.querySelector<HTMLButtonElement>("#copy-profile");
        if (!button) return;
        const link = location.href;
        let copied = false;
        try {
          await navigator.clipboard.writeText(link);
          copied = true;
        } catch {
          const field = document.createElement("textarea");
          field.value = link;
          field.setAttribute("readonly", "");
          field.style.position = "fixed";
          field.style.left = "-9999px";
          document.body.append(field);
          field.select();
          try { copied = document.execCommand("copy"); } catch { copied = false; }
          field.remove();
        }
        button.textContent = copied ? "Ссылка скопирована" : "Не скопировалось";
      });
    }
  }
</script>
