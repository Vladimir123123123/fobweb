---
import Base from "../layouts/Base.astro";
---
<Base title="Гайды — WARDOGS СНГ" description="Инструкции по сайту и достижениям Steam, включая закуп одного комплекта на $100 000.">
  <p class="eyebrow">Сообщество</p>
  <h1>Гайды</h1>
  <p class="lead">Короткие инструкции по сайту и по игре. Условия достижений — как они написаны в Steam.</p>
  <section class="guide-grid" id="guide-grid"></section>
  <section class="guide-notes" id="guide-notes"></section>
  <p class="note" id="guide-empty" hidden>Гайды сейчас не открываются.</p>
</Base>
<script>
  const grid = document.querySelector<HTMLElement>("#guide-grid")!;
  const notes = document.querySelector<HTMLElement>("#guide-notes")!;
  const empty = document.querySelector<HTMLElement>("#guide-empty")!;
  const esc = (value: string) => value.replace(/[&<>"']/g, (ch) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[ch] ?? ch);
  const inline = (value: string) => esc(value).replace(/\*\*(.+?)\*\*/g, "<strong>$1</strong>");
  const htmlOf = (body: string) => body.split(/\n{2,}/).map((chunk) => {
    const lines = chunk.split("\n").map((line) => line.trim()).filter(Boolean);
    if (lines.length && lines.every((line) => line.startsWith("- "))) {
      return `<ul>${lines.map((line) => `<li>${inline(line.slice(2))}</li>`).join("")}</ul>`;
    }
    return `<p>${inline(lines.join(" "))}</p>`;
  }).join("");
  type Guide = { rubric?: string; title?: string; body?: string; href?: string };
  const card = (guide: Guide, linked: boolean) => {
    const body = htmlOf(String(guide.body || ""));
    const head = `<p class="eyebrow">${esc(String(guide.rubric || "Гайд"))}</p><h2>${esc(String(guide.title || "Гайд"))}</h2>${body}`;
    const href = String(guide.href || "");
    if (linked && href) return `<a class="panel" href="${esc(href)}">${head}</a>`;
    const more = href ? `<p><a href="${esc(href)}">Открыть</a></p>` : "";
    return `<article class="panel">${head}${more}</article>`;
  };
  try {
    const response = await fetch("/api/guides");
    if (!response.ok) throw new Error("guides");
    const data = await response.json();
    const guides = Array.isArray(data.guides) ? data.guides as Guide[] : [];
    const short: string[] = [];
    const long: string[] = [];
    for (const guide of guides) {
      const body = String(guide.body || "");
      const href = String(guide.href || "");
      const compact = Boolean(href) && body.length < 320 && !body.includes("\n- ");
      (compact ? short : long).push(card(guide, compact));
    }
    grid.innerHTML = short.join("");
    notes.innerHTML = long.join("");
    if (!guides.length) {
      empty.hidden = false;
      empty.textContent = "Гайдов пока нет.";
    }
  } catch {
    empty.hidden = false;
  }
</script>
