---
import Base from "../layouts/Base.astro";
const season = import.meta.env.GAME_SEASON ?? "03";
---
<Base title="WARDOGS СНГ">
  <section class="stage">
    <img class="stage-photo" src="/brand/banner.jpg" alt="" />
    <div class="stage-copy">
      <p class="eyebrow">Сезон {season}</p>
      <h1>Твоя база.<br /><span>Твои правила.</span></h1>
      <div class="row">
        <a class="btn" href="/vehicles">Техника</a>
        <a class="btn ghost" href="/squads">Найти своих</a>
      </div>
      <section class="server-card" id="live-server">
        <div>
          <p class="eyebrow">Сервер</p>
          <h2 id="live-name">FOB #1 [RU/EU] | 50v50 | NO SNIPER/DMR</h2>
          <p class="note" id="live-note">В браузере серверов WARDOGS.</p>
        </div>
        <div class="live-stats">
          <p><span>Онлайн</span><b id="live-players">0/100</b></p>
          <p><span>Карта</span><b id="live-map">—</b></p>
          <p><span>Режим</span><b id="live-mode">—</b></p>
        </div>
        <div class="live-score" id="live-score"></div>
      </section>
    </div>
  </section>
  <section class="wrap season-lock">
    <div>
      <p class="eyebrow">Сезон 2 · навсегда</p>
      <h2>Трое лучших</h2>
      <div class="podium" id="hall" data-n="3">
        <a class="pod pod-2" href="/p?id=76561198267712279">
          <b>2</b><strong>MATbE_Бал</strong><small>уровень 173</small>
        </a>
        <a class="pod pod-1" href="/p?id=76561198011471623">
          <b>1</b><strong>ReneGADe #Quakenet.org</strong><small>уровень 184</small>
        </a>
        <a class="pod pod-3" href="/p?id=76561198383144234">
          <b>3</b><strong>[[[_WAR_]]]</strong><small>уровень 165</small>
        </a>
      </div>
    </div>
    <div>
      <p class="eyebrow">Лимитед · 50 на 50</p>
      <h2>Сбор на сервер</h2>
      <p class="lead">Цель <b>11 000 ₽</b>. Основатель внёс <b>3 000 ₽</b>.</p>
      <p class="fund-bar" aria-hidden="true"><span style="width: 27.27%"></span></p>
      <p class="note">На камне 3 000 ₽ из 11 000 ₽.</p>
      <div class="stone">
        <p>FOB</p>
        <h3>Пожертвовали</h3>
        <ul>
          <li>Vladimir (9hzkak)<small>3 000 ₽</small></li>
        </ul>
      </div>
    </div>
  </section>
  <script>
    const liveName = document.querySelector("#live-name");
    const livePlayers = document.querySelector("#live-players");
    const liveMap = document.querySelector("#live-map");
    const liveMode = document.querySelector("#live-mode");
    const liveScore = document.querySelector("#live-score");
    const liveNote = document.querySelector("#live-note");
    const paintServer = (data: {
      name?: string;
      players?: number;
      maxPlayers?: number;
      map?: string;
      mode?: string;
      factions?: Array<{ name?: string; score?: number }>;
    }) => {
      if (liveName) liveName.textContent = data.name || "FOB";
      if (livePlayers) livePlayers.textContent = `${data.players ?? 0}/${data.maxPlayers || "?"}`;
      if (liveMap) liveMap.textContent = data.map || "—";
      if (liveMode) liveMode.textContent = data.mode || "—";
      if (liveScore) {
        const rows = Array.isArray(data.factions) ? data.factions : [];
        const esc = (value: string) => value.replace(/[&<>"']/g, (ch) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[ch] ?? ch);
        liveScore.innerHTML = rows.map((row) => `<i>${esc(String(row.name ?? ""))} <b>${Number(row.score) || 0}</b></i>`).join("");
      }
      if (liveNote) liveNote.textContent = "В браузере серверов WARDOGS найди это название.";
    };
    const pullServer = async () => {
      for (const url of ["/api/server", "/live-server.php"]) {
        try {
          const response = await fetch(url);
          if (!response.ok) continue;
          const data = await response.json();
          if (data && data.name) {
            paintServer(data);
            return;
          }
        } catch {
          // следующий источник
        }
      }
      if (liveNote) liveNote.textContent = "Сервер сейчас не отвечает.";
    };
    pullServer();
    setInterval(pullServer, 30000);
  </script>
</Base>
