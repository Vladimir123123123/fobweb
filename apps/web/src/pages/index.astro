---
import Base from "../layouts/Base.astro";
const season = import.meta.env.GAME_SEASON ?? "03";
---
<Base title="FOB — сервер WARDOGS СНГ, 50 на 50" description="Сервер FOB #1 для WARDOGS: 50 на 50, RU/EU, без снайперов и DMR. Рейтинг игроков и сквады.">
  <div class="home-hero">
  <section class="stage">
    <img class="stage-photo" id="battle-map" src="/brand/maps/ozeti.webp" alt="" />
    <canvas class="battle" id="battle"></canvas>
  </section>
    <div class="stage-copy">
      <img class="stage-op" src="/brand/operators/valk.webp" alt="" width="340" height="470" decoding="async" />
      <p class="eyebrow">FOB · сезон {season} · 50 на 50</p>
      <h1>WARDOGS</h1>
      <p class="stage-kicker">Tactical all out warfare</p>
      <div class="row">
        <a class="btn" href="/squads">Найти своих</a>
        <a class="btn ghost" href="https://discord.com/channels/1387770606589706312/1562248789975244801" target="_blank" rel="noopener">Купить VIP</a>
      </div>
      <p class="stage-line">Сервер FOB: RU/EU, без снайперов и DMR. Рейтинг сезона и сквады.</p>
      <div class="home-board">
        <div class="home-main">
          <section class="server-card" id="live-server">
            <div>
              <p class="eyebrow">Сервер</p>
              <h2 id="live-name">FOB #1 [RU/EU] | 50v50 | NO SNIPER/DMR</h2>
              <p class="note" id="live-note">В браузере серверов WARDOGS.</p>
            </div>
            <div class="live-stats">
              <p><span>Онлайн</span><b id="live-players">0/100</b></p>
              <p><span>Карта</span><b id="live-map">—</b></p>
              <p><span>Режим</span><b id="live-mode">—</b></p>
            </div>
            <div class="live-score" id="live-score"></div>
          </section>
          <section class="on-air" id="on-air">
            <p class="eyebrow">В эфире</p>
            <div id="on-air-list"><p class="note">Сейчас никто не стримит.</p></div>
          </section>
          <div id="fight">
      <div class="crawl">
        <span class="live-mark" id="fight-live" hidden>LIVE</span>
        <div class="crawl-window">
          <div class="crawl-track" id="fight-track"></div>
        </div>
        <p class="hot" id="fight-hot" hidden><b>☠</b> HOT</p>
      </div>
      <div id="fight-teams"></div>
          </div>
        </div>
        <aside class="home-side">
          <section class="discord-card" id="discord-card" aria-label="Discord сервера">
            <div class="discord-head">
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.3 4.4A18.6 18.6 0 0 0 15.7 3l-.2.4a17 17 0 0 1 4 1.9 15.5 15.5 0 0 0-13.9 0 17 17 0 0 1 4-1.9L9.4 3a18.6 18.6 0 0 0-4.7 1.4C1.7 8.8.9 13.1 1.300 17.3a18.700 18.700 0 0 0 5.700 2.900l1.200-2a12 12 0 0 1-1.900-.9l.5-.4a13.300 13.300 0 0 0 11.400 0l.5.4c-.6.4-1.200.7-1.900.9l1.200 2a18.700 18.700 0 0 0 5.700-2.900c.5-4.900-.8-9.100-3.400-12.900ZM8.500 14.700c-1.100 0-2-1-2-2.200s.9-2.200 2-2.200 2 1 2 2.200-.9 2.200-2 2.200Zm7 0c-1.100 0-2-1-2-2.200s.9-2.200 2-2.200 2 1 2 2.200-.9 2.200-2 2.200Z"/></svg>
              <div>
                <strong id="discord-name">Discord FOB</strong>
                <small id="discord-online">сообщество</small>
              </div>
            </div>
            <ul class="discord-members" id="discord-members" hidden></ul>
            <ul class="discord-room" id="discord-room" hidden></ul>
            <a class="btn" id="discord-join" href="https://discord.com/invite/yj424ee6" target="_blank" rel="noopener">Войти в Discord</a>
          </section>
          <section class="vip-card">
            <p class="eyebrow">Купили VIP</p>
            <div id="vip-list"><p class="note">Пока пусто.</p></div>
          </section>
        </aside>
      </div>
    </div>
  </div>
  <script>
    const liveName = document.querySelector("#live-name");
    const livePlayers = document.querySelector("#live-players");
    const liveMap = document.querySelector("#live-map");
    const liveMode = document.querySelector("#live-mode");
    const liveScore = document.querySelector("#live-score");
    const liveNote = document.querySelector("#live-note");
    const paintServer = (data: {
      name?: string;
      players?: number;
      maxPlayers?: number;
      map?: string;
      mode?: string;
      factions?: Array<{ name?: string; score?: number }>;
    }) => {
      if (liveName) liveName.textContent = data.name || "FOB";
      if (livePlayers) livePlayers.textContent = `${data.players ?? 0}/${data.maxPlayers || "?"}`;
      if (liveMap) liveMap.textContent = data.map || "—";
      if (liveMode) liveMode.textContent = data.mode || "—";
      if (liveScore) {
        const rows = Array.isArray(data.factions) ? data.factions : [];
        const esc = (value: string) => value.replace(/[&<>"']/g, (ch) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[ch] ?? ch);
        liveScore.innerHTML = rows.map((row) => {
          const name = String(row.name ?? "");
          const key = name.toLowerCase();
          const tone = key.includes("valk") ? "valk" : key.includes("mant") ? "mant" : key.includes("lone") || key.includes("star") ? "lone" : "";
          return `<i class="${tone}">${esc(name)} <b>${Number(row.score) || 0}</b></i>`;
        }).join("");
      }
      if (liveNote) liveNote.textContent = "В браузере серверов WARDOGS найди это название.";
      paintFight(data);
      syncBattle(data);
    };
    const battleMap = document.querySelector<HTMLImageElement>("#battle-map");
    const battle = document.querySelector<HTMLCanvasElement>("#battle");
    const mapArt = (name: string) => {
      const key = name.toLowerCase();
      if (key.includes("ozet") || key.includes("madrid") || key.includes("europe")) return "ozeti";
      if (key.includes("sabat") || key.includes("moscow") || key.includes("russia")) return "sabatulo";
      if (key.includes("bakur") || key.includes("kavkaz")) return "bakurani";
      if (key.includes("zesta") || key.includes("detroit") || key.includes("america")) return "zestafona";
      return "";
    };
    const sideIndex = (name: string) => {
      const key = name.toLowerCase();
      if (key.includes("valk")) return 1;
      if (key.includes("mant")) return 2;
      return 0;
    };
    type Unit = { u: number; v: number; a: number; side: number; wobble: number };
    type Tracer = { from: Unit; to: Unit; life: number };
    const units: Unit[] = [];
    const tracers: Tracer[] = [];
    const colors = ["#6ea2ff", "#e23b3b", "#22b84a"];
    let want = [0, 0, 0];
    let contact = 0;
    const still = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const spawn = (side: number): Unit => {
      const turn = Math.random() * Math.PI * 2;
      const reach = Math.sqrt(Math.random()) * 0.82;
      return { u: Math.cos(turn) * reach, v: Math.sin(turn) * reach, a: Math.random() * Math.PI * 2, side, wobble: Math.random() * 6 };
    };
    const syncBattle = (data: { map?: string; players?: number; teams?: Array<{ name?: string; players?: unknown[] }> }) => {
      const art = mapArt(String(data.map || ""));
      if (battleMap && art) {
        const next = `/brand/maps/${art}.webp`;
        if (!battleMap.src.endsWith(next)) battleMap.src = next;
      }
      const teams = Array.isArray(data.teams) ? data.teams : [];
      const next = [0, 0, 0];
      const online = Math.max(0, Math.min(100, Number(data.players) || 0));
      if (teams.length) {
        const listed = teams.reduce((sum, team) => sum + (team.players?.length || 0), 0);
        for (const team of teams) {
          const share = listed ? (team.players?.length || 0) / listed : 1 / teams.length;
          next[sideIndex(String(team.name || ""))] += Math.round(online * share);
        }
      } else if (online) {
        next[0] = Math.ceil(online / 2);
        next[1] = online - next[0];
      }
      const sum = next[0] + next[1] + next[2];
      if (sum > online && online > 0) next[next.indexOf(Math.max(...next))] -= sum - online;
      want = next;
      if (still) drawBattle();
    };
    const fitBattle = () => {
      if (!battle) return;
      const box = battle.getBoundingClientRect();
      const ratio = Math.min(2, window.devicePixelRatio || 1);
      battle.width = Math.max(1, Math.round(box.width * ratio));
      battle.height = Math.max(1, Math.round(box.height * ratio));
    };
    const drawBattle = () => {
      if (!battle) return;
      const ctx = battle.getContext("2d");
      if (!ctx) return;
      const w = battle.width;
      const h = battle.height;
      const narrow = w < h * 1.15;
      const cx = w * (narrow ? 0.62 : 0.68);
      const cy = h * (narrow ? 0.2 : 0.42);
      const rx = narrow ? w * 0.3 : Math.min(w * 0.24, h * 0.38);
      const ry = h * (narrow ? 0.14 : 0.26);
      const size = Math.max(6, w / 180);
      ctx.clearRect(0, 0, w, h);
      ctx.strokeStyle = "rgba(239, 170, 24, 0.7)";
      ctx.lineWidth = Math.max(1.5, size / 5);
      ctx.beginPath();
      ctx.ellipse(cx, cy, rx, ry, 0, 0, Math.PI * 2);
      ctx.stroke();
      ctx.globalAlpha = 0.45;
      ctx.beginPath();
      ctx.ellipse(cx, cy, rx * 0.62, ry * 0.62, 0, 0, Math.PI * 2);
      ctx.stroke();
      ctx.globalAlpha = 1;
      for (const tracer of tracers) {
        ctx.strokeStyle = "rgba(244, 241, 232, 0.55)";
        ctx.beginPath();
        ctx.moveTo(cx + tracer.from.u * rx, cy + tracer.from.v * ry);
        ctx.lineTo(cx + tracer.to.u * rx, cy + tracer.to.v * ry);
        ctx.stroke();
      }
      for (const unit of units) {
        ctx.save();
        ctx.translate(cx + unit.u * rx, cy + unit.v * ry);
        ctx.rotate(unit.a);
        ctx.beginPath();
        ctx.moveTo(size, 0);
        ctx.lineTo(-size * 0.7, size * 0.5);
        ctx.lineTo(-size * 0.7, -size * 0.5);
        ctx.closePath();
        ctx.fillStyle = colors[unit.side] ?? colors[0];
        ctx.fill();
        ctx.restore();
      }
    };
    const moveBattle = (dt: number) => {
      for (let side = 0; side < 3; side += 1) {
        const have = units.filter((unit) => unit.side === side).length;
        if (have < want[side]) {
          for (let i = have; i < want[side]; i += 1) units.push(spawn(side));
        } else if (have > want[side]) {
          let extra = have - want[side];
          for (let i = units.length - 1; i >= 0 && extra > 0; i -= 1) {
            if (units[i].side !== side) continue;
            units.splice(i, 1);
            extra -= 1;
          }
        }
      }
      for (const unit of units) {
        unit.wobble += dt;
        unit.a += Math.sin(unit.wobble) * dt * 0.55;
        unit.u += Math.cos(unit.a) * dt * 0.05;
        unit.v += Math.sin(unit.a) * dt * 0.05;
        if (unit.u * unit.u + unit.v * unit.v > 0.9) unit.a = Math.atan2(-unit.v, -unit.u) + (Math.random() - 0.5);
      }
      for (let i = tracers.length - 1; i >= 0; i -= 1) {
        tracers[i].life -= dt;
        if (tracers[i].life <= 0) tracers.splice(i, 1);
      }
      contact += dt;
      if (contact > 2.4 && tracers.length < 3) {
        contact = 0;
        const red = units.filter((unit) => unit.side === 1);
        const other = units.filter((unit) => unit.side !== 1);
        if (red.length && other.length) {
          const from = red[Math.floor(Math.random() * red.length)];
          const to = other[Math.floor(Math.random() * other.length)];
          const dx = from.u - to.u;
          const dy = from.v - to.v;
          if (dx * dx + dy * dy < 0.35) tracers.push({ from, to, life: 0.35 });
        }
      }
      drawBattle();
    };
    if (battle) {
      fitBattle();
      new ResizeObserver(fitBattle).observe(battle);
      if (!still) {
        let last = performance.now();
        const frame = (now: number) => {
          const dt = Math.min(0.05, (now - last) / 1000);
          last = now;
          moveBattle(dt);
          requestAnimationFrame(frame);
        };
        requestAnimationFrame(frame);
      }
    }
    const marks: Record<string, string> = { lone: "/brand/factions/ls.png", valk: "/brand/factions/vk.png", mant: "/brand/factions/mc.png" };
    const markOf = (name: string) => {
      const key = name.toLowerCase();
      const found = Object.keys(marks).find((part) => key.includes(part));
      return found ? marks[found] : "";
    };
    const fightHot = document.querySelector<HTMLElement>("#fight-hot");
    const fightLive = document.querySelector<HTMLElement>("#fight-live");
    const fightTrack = document.querySelector<HTMLElement>("#fight-track");
    const fightTeams = document.querySelector("#fight-teams");
    let crawlKey = "\u0000";
    const paintFight = (data: {
      hot?: boolean;
      online?: boolean;
      players?: number;
      feed?: Array<{ killer?: string; victim?: string; weapon?: string; meters?: number | null; headshot?: boolean; name?: string; gained?: number }>;
      teams?: Array<{ name?: string; avgHours?: number | null; players?: Array<{ name?: string; steamId?: string; kills?: number }> }>;
    }) => {
      if (fightHot) fightHot.hidden = !data.hot;
      if (fightLive) fightLive.hidden = !(data.online !== false && (data.players ?? 0) > 0);
      if (!fightTeams || !Array.isArray(data.teams)) return;
      fightTeams.dataset.cols = String(Math.max(1, Math.min(3, data.teams.length || 2)));
      const esc = (value: string) => value.replace(/[&<>"']/g, (ch) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[ch] ?? ch);
      const lines = Array.isArray(data.feed) && data.feed.some((item) => item.victim)
        ? data.feed.flatMap((item) => {
          if (!item.victim) return [];
          const weapon = item.weapon ? ` · ${item.weapon}` : "";
          const distance = item.meters ? ` · ${item.meters} м` : "";
          const head = item.headshot ? " · в голову" : "";
          const line = item.killer
            ? `${item.killer} убил ${item.victim}${weapon}${distance}${head}`
            : `${item.victim} погиб${weapon}${distance}`;
          return [line];
        })
        : [];
      const key = lines.join("|");
      if (fightTrack && key !== crawlKey) {
        crawlKey = key;
        const chunk = lines.length ? lines.map((line) => `<span>${esc(line)}</span>`).join("") : "<span>ждём киллфид</span>";
        fightTrack.innerHTML = chunk + chunk;
      }
      fightTeams.innerHTML = data.teams.map((team) => {
        const name = String(team.name || "Сторона");
        const icon = markOf(name);
        const people = Array.isArray(team.players) ? team.players : [];
        const hours = !people.length ? "" : team.avgHours == null ? "часы скрыты" : `в среднем ${team.avgHours} ч`;
        const rows = people.length
          ? people.map((player) => {
            const label = esc(String(player.name || "игрок"));
            const id = String(player.steamId || "");
            const who = /^\d{17}$/.test(id) ? `<a href="/p?id=${id}">${label}</a>` : label;
            return `<p class="fight-row">${who}<b>${Number(player.kills) || 0} уб.</b></p>`;
          }).join("")
          : `<p class="note">никого</p>`;
        const key = name.toLowerCase();
        const tone = key.includes("valk") ? "valk" : key.includes("mant") ? "mant" : key.includes("lone") || key.includes("star") ? "lone" : "";
        return `<section class="fight-team ${tone}">
          <h3>${icon ? `<img src="${icon}" alt="" />` : ""}${esc(name)}<small>${hours}</small></h3>
          ${rows}
        </section>`;
      }).join("");
    };
    const pullServer = async () => {
      for (const url of ["/api/server", "/live-server.php"]) {
        try {
          const response = await fetch(url);
          if (!response.ok) continue;
          const data = await response.json();
          if (data && data.name) {
            paintServer(data);
            return;
          }
        } catch {
          // следующий источник
        }
      }
      if (liveNote) liveNote.textContent = "Сервер сейчас не отвечает.";
    };
    const onAirList = document.querySelector("#on-air-list");
    const vipList = document.querySelector("#vip-list");
    const escSide = (value: string) => value.replace(/[&<>"']/g, (ch) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[ch] ?? ch);
    const boughtVip: Array<{ name: string; steamId: string; kind: string; until: string }> = [
      { name: "[FOB] DELATUS", steamId: "", kind: "vip", until: "" },
      { name: "[FOB] Skipa", steamId: "76561198335468517", kind: "vip", until: "" },
      { name: "[FOB] Muma", steamId: "76561197970353437", kind: "vip", until: "" },
      { name: "[FOB] Alpinist", steamId: "76561198036099991", kind: "vip", until: "" },
      { name: "[FOB] Faza", steamId: "76561198145925405", kind: "vip", until: "2027-02-12" },
      { name: "[PUGS] ChiefS", steamId: "76561198127097504", kind: "clanvip", until: "2026-12-18" },
      { name: "[KRIG] Wachtmeister", steamId: "76561199782621781", kind: "vip", until: "2026-12-18" },
      { name: "[KRIG] СТАЗлиН", steamId: "", kind: "vip", until: "2026-12-18" },
      { name: "[KRIG] Доминик Де КоКо", steamId: "76561198135239321", kind: "vip", until: "2026-12-18" },
      { name: "[OCO] Markul", steamId: "76561199401400920", kind: "vip", until: "2026-12-18" },
      { name: "[PAPA] dispise", steamId: "76561199434883916", kind: "vip", until: "2026-12-15" },
      { name: "[KRIG] Star_Kir", steamId: "76561198122381125", kind: "clanvip", until: "2026-12-17" },
      { name: "[KRIG] bruh", steamId: "76561199453802002", kind: "vip", until: "2026-12-17" },
      { name: "[KRIG] dead inside 13 y.o.", steamId: "76561198174924646", kind: "vip", until: "2026-12-17" },
      { name: "[KRIG] OmletKing", steamId: "76561198012409678", kind: "vip", until: "2026-12-17" },
      { name: "[KRIEG] Gall", steamId: "76561198116313946", kind: "vip", until: "2026-12-17" },
      { name: "[KRIG] Димкасян", steamId: "76561198020858708", kind: "vip", until: "2026-12-17" },
      { name: "[KRIG] WOLCHIE", steamId: "76561198313393167", kind: "vip", until: "2026-12-17" },
      { name: "Knight Tairus", steamId: "76561198067827889", kind: "vip", until: "2026-12-17" },
      { name: "sixteen spb", steamId: "76561198326177457", kind: "vip", until: "2026-12-17" },
      { name: "76561198196140033", steamId: "76561198196140033", kind: "vip", until: "2026-12-17" },
    ];
    const paintVips = (vips: Array<{ name?: string; steamId?: string; kind?: string; until?: string }>) => {
      if (!vipList) return;
      vipList.innerHTML = vips.length
        ? vips.map((row) => {
          const kind = row.kind === "clanvip" ? "клановый" : "VIP";
          const until = String(row.until || "");
          const day = /^\d{4}-\d{2}-\d{2}$/.test(until) ? until.split("-").reverse().join(".") : "";
          const when = day ? `до ${day}` : "навсегда";
          const steam = String(row.steamId || "");
          const label = escSide(String(row.name || "Игрок"));
          const who = /^\d{17}$/.test(steam) ? `<a href="/p?id=${steam}">${label}</a>` : label;
          const crown = `<svg class="crown" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M3 7l4.500 4L12 4l4.500 7L21 7l-2 12H5L3 7Zm2.800 14h12.400v2H5.800v-2Z"/></svg>`;
          return `<p class="vip-row${row.kind === "clanvip" ? " clan" : ""}">${crown}<span>${who}</span><b>${kind} · ${when}</b></p>`;
        }).join("")
        : `<p class="note">Пока пусто.</p>`;
    };
    paintVips(boughtVip);
    const paintSide = (data: { streams?: Array<{ name?: string; url?: string; platform?: string; viewers?: number; title?: string }>; vips?: Array<{ name?: string; kind?: string; until?: string }> }) => {
      const streams = Array.isArray(data.streams) ? data.streams : [];
      const vips = Array.isArray(data.vips) ? data.vips : [];
      if (onAirList) {
        onAirList.innerHTML = streams.length
          ? streams.map((row) => {
            const name = escSide(String(row.name || "Стример"));
            const url = String(row.url || "");
            const safe = /^https:\/\//.test(url) ? escSide(url) : "";
            const platform = escSide(String(row.platform || ""));
            const title = row.title ? escSide(String(row.title)) : "";
            const viewers = Number(row.viewers) || 0;
            const body = `<b>${name}</b><span>${platform}${viewers ? ` · ${viewers}` : ""}</span>${title ? `<span>${title}</span>` : ""}`;
            return safe ? `<a class="on-air-card" href="${safe}" target="_blank" rel="noopener">${body}</a>` : `<div class="on-air-card">${body}</div>`;
          }).join("")
          : `<p class="note">Сейчас никто не стримит.</p>`;
      }
      if (vips.length) paintVips(vips);
    };
    const pullSide = async () => {
      try {
        const response = await fetch("/api/side");
        if (!response.ok) return;
        paintSide(await response.json());
      } catch {
        // блоки остаются с пустой подписью
      }
    };
    const pullDiscord = async () => {
      try {
        const response = await fetch("/api/discord");
        if (!response.ok) return;
        const data = await response.json() as { name?: string; invite?: string; online?: number; channels?: string[]; members?: Array<{ name: string; status: string; avatar: string }> };
        const name = document.querySelector("#discord-name");
        const online = document.querySelector("#discord-online");
        const members = document.querySelector<HTMLElement>("#discord-members");
        const room = document.querySelector<HTMLElement>("#discord-room");
        const join = document.querySelector<HTMLAnchorElement>("#discord-join");
        if (name && data.name) name.textContent = data.name;
        if (online) online.textContent = `${Number(data.online) || 0} онлайн`;
        if (join && data.invite) join.href = data.invite;
        if (members && data.members?.length) {
          members.innerHTML = data.members.map((row) => `<li data-s="${escSide(row.status)}" title="${escSide(row.name)}">${row.avatar ? `<img src="${escSide(row.avatar)}" alt="" width="30" height="30" loading="lazy" />` : ""}</li>`).join("");
          members.hidden = false;
        }
        if (room && data.channels?.length) {
          room.innerHTML = data.channels.map((row) => `<li>${escSide(row)}</li>`).join("");
          room.hidden = false;
        }
      } catch {
        // остаётся карточка со ссылкой на приглашение
      }
    };
    pullServer();
    pullSide();
    pullDiscord();
    setInterval(pullServer, 10000);
    setInterval(pullSide, 60000);
    setInterval(pullDiscord, 120000);
  </script>
</Base>
